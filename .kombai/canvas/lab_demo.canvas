        "h": 800
      },
      "html": "<main class=\"min-h-screen bg-[var(--color-azure-mist)] font-['IBM_Plex_Sans'] overflow-x-hidden selection:bg-[var(--color-cerulean)] selection:text-white\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .glass-panel {\n      background: rgba(255, 255, 255, 0.65);\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      border: 1px solid var(--color-lab-border);\n    }\n\n    .card-connected {\n      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);\n    }\n\n    .card-connected:hover {\n      transform: translateY(-8px) scale(1.02);\n    }\n\n    .dna-path {\n      stroke-dasharray: 10;\n      animation: dash 20s linear infinite;\n    }\n\n    @keyframes dash {\n      to {\n        stroke-dashoffset: -1000;\n      }\n    }\n\n    .ring-rotate {\n      animation: rotate 60s linear infinite;\n    }\n\n    @keyframes rotate {\n      from { transform: rotate(0deg); }\n      to { transform: rotate(360deg); }\n    }\n\n    .marquee-track {\n      animation: marquee 30s linear infinite;\n    }\n\n    @keyframes marquee {\n      from { transform: translateX(0); }\n      to { transform: translateX(-50%); }\n    }\n  </style>\n\n  <!-- Floating Navigation -->\n  <nav class=\"fixed top-8 left-1/2 -translate-x-1/2 z-50 px-8 py-3 glass-panel rounded-full shadow-[0_8px_32px_rgba(0,123,167,0.12)] flex items-center gap-10\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <i class=\"ti ti-hexagon text-[var(--color-cerulean)] text-xl\" data-kid=\"4\"></i>\n      <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-slate-800 tracking-tight text-sm\" data-kid=\"5\">AQUALAB</span>\n    </div>\n    <ul class=\"flex items-center gap-8\" data-kid=\"6\">\n      <li data-kid=\"7\"><button class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-slate-800 transition-colors cursor-pointer\" data-kid=\"8\">Inicio</button></li>\n      <li data-kid=\"9\"><button class=\"px-4 py-1.5 bg-[var(--color-cerulean)] text-white rounded-full text-[10px] font-bold uppercase tracking-widest shadow-lg shadow-[var(--color-cerulean)]/20 cursor-pointer\" data-kid=\"10\">Servicios</button></li>\n      <li data-kid=\"11\"><button class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-slate-800 transition-colors cursor-pointer\" data-kid=\"12\">Sedes</button></li>\n      <li data-kid=\"13\"><button class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-slate-800 transition-colors cursor-pointer\" data-kid=\"14\">Resultados</button></li>\n    </ul>\n    <div class=\"w-8 h-8 rounded-full border border-slate-100 flex items-center justify-center cursor-pointer hover:bg-white transition-colors\" data-kid=\"15\">\n      <i class=\"ti ti-search text-slate-400 text-sm\" data-kid=\"16\"></i>\n    </div>\n  </nav>\n\n  <!-- Hero Section with Radial Focus -->\n  <header class=\"relative pt-48 pb-32 text-center bg-[radial-gradient(circle_at_center,white_0%,var(--color-azure-mist)_100%)] overflow-hidden\" data-kid=\"17\">\n    <!-- Concentric Background Rings -->\n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\" data-kid=\"18\">\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/perpendicular-rings.svg\" alt=\"Rings\" class=\"w-[800px] h-[800px] ring-rotate text-[var(--color-cerulean)]\" style=\"filter: brightness(0) saturate(100%) invert(31%) sepia(85%) saturate(1067%) hue-rotate(164deg) brightness(97%) contrast(103%);\" data-kid=\"19\">\n    </div>\n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-10\" data-kid=\"20\">\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/perpendicular-rings.svg\" alt=\"Rings\" class=\"w-[1200px] h-[1200px] ring-rotate text-[var(--color-cerulean)]\" style=\"filter: brightness(0) saturate(100%) invert(31%) sepia(85%) saturate(1067%) hue-rotate(164deg) brightness(97%) contrast(103%); animation-direction: reverse; animation-duration: 90s;\" data-kid=\"21\">\n    </div>\n\n    <div class=\"relative z-10 max-w-3xl mx-auto px-6\" data-kid=\"22\">\n      <div class=\"animate-hero inline-flex items-center gap-2 px-4 py-1.5 bg-white/60 backdrop-blur-sm border border-white rounded-full mb-8 shadow-sm\" data-kid=\"23\">\n        <span class=\"w-1.5 h-1.5 bg-[var(--color-cerulean)] rounded-full animate-pulse\" data-kid=\"24\"></span>\n        <span class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-cerulean)]\" data-kid=\"25\">Ecosistema Conectado</span>\n      </div>\n      <h1 class=\"animate-hero font-['Plus_Jakarta_Sans'] text-6xl md:text-7xl font-extrabold text-slate-900 tracking-tighter leading-[1.1] mb-8\" data-kid=\"26\">\n        Nuestros <span class=\"text-[var(--color-cerulean)]\" data-kid=\"27\">Servicios</span> de <br data-kid=\"28\"> Alta Precisión\n      </h1>\n      <p class=\"animate-hero text-slate-500 text-lg font-medium leading-relaxed max-w-2xl mx-auto\" data-kid=\"29\">\n        Contamos con una amplia cartera de análisis y pruebas de diagnóstico respaldadas por tecnología de vanguardia y un ecosistema clínico integrado.\n      </p>\n    </div>\n  </header>\n\n  <!-- Connected Grid Section -->\n  <section class=\"relative max-w-6xl mx-auto px-6 pb-48\" data-kid=\"30\">\n    <!-- SVG Connection Line (DNA Strand Idea) -->\n    <svg class=\"absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible\" data-kid=\"31\">\n      <path id=\"connection-path\" d=\"M 360 100 Q 720 300 360 500 T 360 900 T 360 1300\" fill=\"none\" stroke=\"var(--color-cerulean)\" stroke-width=\"2\" stroke-dasharray=\"12 12\" class=\"dna-path opacity-20\" data-kid=\"32\" />\n    </svg>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-24\" data-kid=\"33\">\n      <!-- Service 01 -->\n      <div class=\"animate-card translate-y-0\" data-kid=\"34\">\n        <div class=\"card-connected group relative p-10 bg-white rounded-[3rem] shadow-[0_20px_60px_-15px_rgba(0,123,167,0.06)] border border-white flex gap-8 items-start\" data-kid=\"35\">\n          <div class=\"relative shrink-0\" data-kid=\"36\">\n            <div class=\"icon-pulse absolute inset-0 bg-[var(--color-azure-mist)] rounded-full -m-2 opacity-50\" data-kid=\"37\"></div>\n            <div class=\"relative w-20 h-20 bg-white rounded-full border border-[var(--color-lab-border)] flex items-center justify-center shadow-inner group-hover:border-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"38\">\n              <i class=\"ti ti-microscope text-3xl text-slate-300 group-hover:text-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"39\"></i>\n            </div>\n          </div>\n          <div data-kid=\"40\">\n            <span class=\"text-[10px] font-extrabold text-[var(--color-cerulean)]/40 uppercase tracking-widest block mb-2\" data-kid=\"41\">01 / Diagnóstico</span>\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"42\">Inmunología</h3>\n            <p class=\"text-slate-500 text-sm leading-relaxed font-medium\" data-kid=\"43\">Pruebas hormonales, marcadores tumorales e infecciosos con alta sensibilidad clínica.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Service 02 (Offset) -->\n      <div class=\"animate-card md:translate-y-24\" data-kid=\"44\">\n        <div class=\"card-connected group relative p-10 bg-white rounded-[3rem] shadow-[0_20px_60px_-15px_rgba(0,123,167,0.06)] border border-white flex gap-8 items-start\" data-kid=\"45\">\n          <div class=\"relative shrink-0\" data-kid=\"46\">\n            <div class=\"icon-pulse absolute inset-0 bg-[var(--color-azure-mist)] rounded-full -m-2 opacity-50\" data-kid=\"47\"></div>\n            <div class=\"relative w-20 h-20 bg-white rounded-full border border-[var(--color-lab-border)] flex items-center justify-center shadow-inner group-hover:border-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"48\">\n              <i class=\"ti ti-flask text-3xl text-slate-300 group-hover:text-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"49\"></i>\n            </div>\n          </div>\n          <div data-kid=\"50\">\n            <span class=\"text-[10px] font-extrabold text-[var(--color-cerulean)]/40 uppercase tracking-widest block mb-2\" data-kid=\"51\">02 / Análisis</span>\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"52\">Bioquímica Clínica</h3>\n            <p class=\"text-slate-500 text-sm leading-relaxed font-medium\" data-kid=\"53\">Perfiles metabólicos, renales, hepáticos y lípidos automatizados para precisión total.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Service 03 -->\n      <div class=\"animate-card translate-y-0\" data-kid=\"54\">\n        <div class=\"card-connected group relative p-10 bg-white rounded-[3rem] shadow-[0_20px_60px_-15px_rgba(0,123,167,0.06)] border border-white flex gap-8 items-start\" data-kid=\"55\">\n          <div class=\"relative shrink-0\" data-kid=\"56\">\n            <div class=\"icon-pulse absolute inset-0 bg-[var(--color-azure-mist)] rounded-full -m-2 opacity-50\" data-kid=\"57\"></div>\n            <div class=\"relative w-20 h-20 bg-white rounded-full border border-[var(--color-lab-border)] flex items-center justify-center shadow-inner group-hover:border-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"58\">\n              <i class=\"ti ti-droplets text-3xl text-slate-300 group-hover:text-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"59\"></i>\n            </div>\n          </div>\n          <div data-kid=\"60\">\n            <span class=\"text-[10px] font-extrabold text-[var(--color-cerulean)]/40 uppercase tracking-widest block mb-2\" data-kid=\"61\">03 / Citología</span>\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"62\">Hematología</h3>\n            <p class=\"text-slate-500 text-sm leading-relaxed font-medium\" data-kid=\"63\">Hemogramas completos y estudios especializados de coagulación con reporte instantáneo.</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Service 04 (Offset) -->\n      <div class=\"animate-card md:translate-y-24\" data-kid=\"64\">\n        <div class=\"card-connected group relative p-10 bg-white rounded-[3rem] shadow-[0_20px_60px_-15px_rgba(0,123,167,0.06)] border border-white flex gap-8 items-start\" data-kid=\"65\">\n          <div class=\"relative shrink-0\" data-kid=\"66\">\n            <div class=\"icon-pulse absolute inset-0 bg-[var(--color-azure-mist)] rounded-full -m-2 opacity-50\" data-kid=\"67\"></div>\n            <div class=\"relative w-20 h-20 bg-white rounded-full border border-[var(--color-lab-border)] flex items-center justify-center shadow-inner group-hover:border-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"68\">\n              <i class=\"ti ti-dna text-3xl text-slate-300 group-hover:text-[var(--color-cerulean)] transition-colors duration-500\" data-kid=\"69\"></i>\n            </div>\n          </div>\n          <div data-kid=\"70\">\n            <span class=\"text-[10px] font-extrabold text-[var(--color-cerulean)]/40 uppercase tracking-widest block mb-2\" data-kid=\"71\">04 / Genética</span>\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-3 group-hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"72\">Biología Molecular</h3>\n            <p class=\"text-slate-500 text-sm leading-relaxed font-medium\" data-kid=\"73\">Detección por PCR de patógenos virales y estudios genéticos de alta complejidad.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Certifications Marquee -->\n  <footer class=\"w-full bg-white border-t border-slate-50 py-16 overflow-hidden\" data-kid=\"74\">\n    <div class=\"max-w-7xl mx-auto px-6 mb-12 flex items-center justify-between\" data-kid=\"75\">\n      <div data-kid=\"76\">\n        <h4 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800\" data-kid=\"77\">Acreditaciones Internacionales</h4>\n        <p class=\"text-slate-400 text-sm mt-1\" data-kid=\"78\">Comprometidos con los más altos estándares globales.</p>\n      </div>\n      <button class=\"px-6 py-3 bg-[var(--color-azure-mist)] text-[var(--color-cerulean)] rounded-full text-[10px] font-bold uppercase tracking-widest border border-[var(--color-lab-border)] hover:bg-white transition-all cursor-pointer\" data-kid=\"79\">\n        Ver Certificaciones\n      </button>\n    </div>\n\n    <div class=\"relative flex overflow-hidden group\" data-kid=\"80\">\n      <div class=\"marquee-track flex gap-12 whitespace-nowrap px-6 items-center\" data-kid=\"81\">\n        <!-- Certification Items (Duplicated for seamless loop) -->\n        <div class=\"flex items-center gap-4 bg-slate-50/50 px-8 py-4 rounded-full border border-slate-100\" data-kid=\"82\">\n          <div class=\"w-12 h-12 rounded-full border-2 border-[var(--color-cerulean)] flex items-center justify-center p-2\" data-kid=\"83\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/double-ringed-orb.svg\" alt=\"ISO\" class=\"w-full h-full opacity-40\" data-kid=\"84\">\n          </div>\n          <span class=\"font-bold text-slate-400 uppercase tracking-widest text-xs\" data-kid=\"85\">ISO 9001:2015</span>\n        </div>\n        <div class=\"flex items-center gap-4 bg-slate-50/50 px-8 py-4 rounded-full border border-slate-100\" data-kid=\"86\">\n          <div class=\"w-12 h-12 rounded-full border-2 border-[var(--color-cerulean)] flex items-center justify-center p-2\" data-kid=\"87\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/linked-rings.svg\" alt=\"CAP\" class=\"w-full h-full opacity-40\" data-kid=\"88\">\n          </div>\n          <span class=\"font-bold text-slate-400 uppercase tracking-widest text-xs\" data-kid=\"89\">CAP ACCREDITED</span>\n        </div>\n        <div class=\"flex items-center gap-4 bg-slate-50/50 px-8 py-4 rounded-full border border-slate-100\" data-kid=\"90\">\n          <div class=\"w-12 h-12 rounded-full border-2 border-[var(--color-cerulean)] flex items-center justify-center p-2\" data-kid=\"91\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/fire-ring.svg\" alt=\"FDA\" class=\"w-full h-full opacity-40\" data-kid=\"92\">\n          </div>\n          <span class=\"font-bold text-slate-400 uppercase tracking-widest text-xs\" data-kid=\"93\">FDA COMPLIANT</span>\n        </div>\n        <!-- Repeat -->\n        <div class=\"flex items-center gap-4 bg-slate-50/50 px-8 py-4 rounded-full border border-slate-100\" data-kid=\"94\">\n          <div class=\"w-12 h-12 rounded-full border-2 border-[var(--color-cerulean)] flex items-center justify-center p-2\" data-kid=\"95\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/double-ringed-orb.svg\" alt=\"ISO\" class=\"w-full h-full opacity-40\" data-kid=\"96\">\n          </div>\n          <span class=\"font-bold text-slate-400 uppercase tracking-widest text-xs\" data-kid=\"97\">ISO 9001:2015</span>\n        </div>\n        <div class=\"flex items-center gap-4 bg-slate-50/50 px-8 py-4 rounded-full border border-slate-100\" data-kid=\"98\">\n          <div class=\"w-12 h-12 rounded-full border-2 border-[var(--color-cerulean)] flex items-center justify-center p-2\" data-kid=\"99\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/linked-rings.svg\" alt=\"CAP\" class=\"w-full h-full opacity-40\" data-kid=\"100\">\n          </div>\n          <span class=\"font-bold text-slate-400 uppercase tracking-widest text-xs\" data-kid=\"101\">CAP ACCREDITED</span>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"102\"></script>\n  <script type=\"module\" data-kid=\"103\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    // Entrance Animations\n    gsap.from(\".animate-hero\", {\n      autoAlpha: 0,\n      y: 40,\n      stagger: 0.2,\n      duration: 1.2,\n      ease: \"power4.out\"\n    });\n\n    gsap.from(\".animate-card\", {\n      autoAlpha: 0,\n      y: 60,\n      stagger: 0.15,\n      duration: 1,\n      ease: \"power3.out\",\n      delay: 0.6\n    });\n\n    // Dash Array Animation for DNA line\n    gsap.from(\"#connection-path\", {\n      strokeDashoffset: 1000,\n      duration: 3,\n      ease: \"none\",\n      repeat: -1\n    });\n\n    // Hover Micro-interactions with Anime.js\n    const cards = document.querySelectorAll('.card-connected');\n    cards.forEach(card => {\n      const pulse = card.querySelector('.icon-pulse');\n      \n      card.addEventListener('mouseenter', () => {\n        animate(pulse, {\n          scale: [1, 1.4],\n          opacity: [0.5, 0],\n          duration: 800,\n          easing: 'easeOutQuart'\n        });\n      });\n    });\n  </script>\n</main>",
      "comments": [],
      "created": "2026-07-04T00:12:09.941433+00:00",
      "modified": "2026-07-04T00:12:36.064200+00:00",
      "id": "var_c1dcc1b953e3"
    },
    "var_8ab7fb4cbe97": {
      "type": "variant",
      "label": "Sedes públicas — mapas visibles",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n</style>\n<section class=\"min-h-screen w-full bg-white px-6 py-16 font-['IBM_Plex_Sans'] text-slate-700\" data-kid=\"1\" data-name=\"sedes section container\" style=\"--brand-red:#E52320; --brand-navy:#1E3A4C; --mist:#FFF5F5; --line:#FEE2E2;\">\n    <div class=\"mx-auto max-w-5xl\" data-kid=\"1-1\" data-name=\"section content wrapper\">\n        <header class=\"mb-12 text-center\" data-kid=\"1-1-1\" data-name=\"section header group\">\n            <div class=\"mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--mist)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--brand-red)]\" data-kid=\"1-1-1-1\" data-name=\"status badge\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--brand-red)]\" data-kid=\"1-1-1-1-1\" data-name=\"status indicator dot\">\n                </span>\n                Atención presencial\n            </div>\n            <h1 class=\"font-['Plus_Jakarta_Sans'] text-4xl font-extrabold tracking-tight text-slate-900\" data-kid=\"1-1-1-2\" data-name=\"section headline\">\n                Nuestras Sedes en Tacna\n            </h1>\n            <p class=\"mx-auto mt-3 max-w-2xl text-base leading-relaxed text-slate-500\" data-kid=\"1-1-1-3\" data-name=\"section description text\">\n                Visítanos en nuestras sedes de Av. Leguía y Patricio Meléndez para tu atención rápida y confiable.\n            </p>\n        </header>\n        <div class=\"grid grid-cols-1 gap-8 lg:grid-cols-2\" data-kid=\"1-1-2\" data-name=\"locations grid container\">\n            <article class=\"overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-[0_15px_30px_-10px_rgba(0,0,0,0.04)] transition-shadow duration-300 hover:shadow-[0_20px_40px_-12px_rgba(229,35,32,0.14)]\" data-kid=\"1-1-2-1\" data-name=\"location card 01\">\n                <div class=\"grid min-h-[33rem] grid-cols-1 lg:grid-cols-[1.08fr_0.92fr]\" data-kid=\"1-1-2-1-1\" data-name=\"location card inner layout\">\n                    <div class=\"flex flex-col justify-between p-7 sm:p-8\" data-kid=\"1-1-2-1-1-1\" data-name=\"location details area\">\n                        <div data-kid=\"1-1-2-1-1-1-1\" data-name=\"location basic info container\">\n                            <div class=\"mb-5 flex items-start justify-between gap-4\" data-kid=\"1-1-2-1-1-1-1-1\" data-name=\"header layout container\">\n                                <div data-kid=\"1-1-2-1-1-1-1-1-1\" data-name=\"location title block\">\n                                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--brand-red)]\" data-kid=\"1-1-2-1-1-1-1-1-1-1\" data-name=\"location label text\">\n                                        Sede 01\n                                    </p>\n                                    <h2 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold leading-tight text-slate-900 sm:text-3xl\" data-kid=\"1-1-2-1-1-1-1-1-1-2\" data-name=\"location name headline\">\n                                        Avenida Leguía\n                                    </h2>\n                                </div>\n                                <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--mist)] text-[var(--brand-red)]\" data-kid=\"1-1-2-1-1-1-1-1-2\" data-name=\"icon box container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-building-hospital text-xl\" data-kid=\"1-1-2-1-1-1-1-1-2-1\" data-name=\"hospital building icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <div class=\"mb-7 flex items-start gap-2.5 text-slate-600\" data-kid=\"1-1-2-1-1-1-1-2\" data-name=\"location address block\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin mt-0.5 shrink-0 text-xl text-[var(--brand-red)]\" data-kid=\"1-1-2-1-1-1-1-2-1\" data-name=\"map pin icon\">\n                                </i>\n                                <span class=\"text-sm font-medium leading-relaxed\" data-kid=\"1-1-2-1-1-1-1-2-2\" data-name=\"address text\">\n                                    Av. Leguía, Tacna\n                                </span>\n                            </div>\n                            <div class=\"space-y-3\" data-kid=\"1-1-2-1-1-1-1-3\" data-name=\"amenities list container\">\n                                <div class=\"flex items-center gap-3 text-slate-600\" data-kid=\"1-1-2-1-1-1-1-3-1\" data-name=\"amenity item container\">\n                                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-50 text-[var(--brand-red)]\" data-kid=\"1-1-2-1-1-1-1-3-1-1\" data-name=\"amenity icon box\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-flask text-base\" data-kid=\"1-1-2-1-1-1-1-3-1-1-1\" data-name=\"flask icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-xs font-semibold\" data-kid=\"1-1-2-1-1-1-1-3-1-2\" data-name=\"amenity name text\">\n                                        Laboratorio Clínico\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 text-slate-600\" data-kid=\"1-1-2-1-1-1-1-3-2\" data-name=\"amenity item container\">\n                                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600\" data-kid=\"1-1-2-1-1-1-1-3-2-1\" data-name=\"amenity icon box\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-vaccine text-base\" data-kid=\"1-1-2-1-1-1-1-3-2-1-1\" data-name=\"vaccine icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-xs font-semibold\" data-kid=\"1-1-2-1-1-1-1-3-2-2\" data-name=\"amenity name text\">\n                                        Vacunas & Tomas\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 text-slate-600\" data-kid=\"1-1-2-1-1-1-1-3-3\" data-name=\"amenity item container\">\n                                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600\" data-kid=\"1-1-2-1-1-1-1-3-3-1\" data-name=\"amenity icon box\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-parking text-base\" data-kid=\"1-1-2-1-1-1-1-3-3-1-1\" data-name=\"parking icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-xs font-semibold\" data-kid=\"1-1-2-1-1-1-1-3-3-2\" data-name=\"amenity name text\">\n                                        Estacionamiento\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <a class=\"mt-8 inline-flex w-fit items-center gap-2 rounded-xl bg-[var(--brand-red)] px-4 py-3 text-xs font-bold text-white shadow-sm shadow-red-200 transition-colors hover:bg-red-700\" data-kid=\"1-1-2-1-1-1-2\" data-name=\"google maps CTA button\" href=\"https://maps.app.goo.gl/HUAqRFnH5PYh8r1q6\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brand-google-maps text-base\" data-kid=\"1-1-2-1-1-1-2-1\" data-name=\"google maps icon\">\n                            </i>\n                            Abrir en Google Maps\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-sm\" data-kid=\"1-1-2-1-1-1-2-2\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"relative min-h-[20rem] overflow-hidden bg-slate-100 lg:min-h-full\" data-kid=\"1-1-2-1-1-2\" data-name=\"map view container\">\n                        <iframe class=\"absolute inset-0 h-full w-full border-0\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"google maps embedded iframe\" data-reason=\"source URL updated to include zoom and map type parameters\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://maps.google.com/maps?q=Av.%20Legu%C3%ADa%2C%20Tacna%2C%20Per%C3%BA&t=m&z=15&output=embed\" title=\"Mapa de ubicación de la sede Avenida Leguía\">\n                        </iframe>\n                        <div class=\"pointer-events-none absolute left-4 top-4 inline-flex items-center gap-2 rounded-lg border border-white/80 bg-white/90 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-700 shadow-sm backdrop-blur-sm\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"map label badge\">\n                            <span class=\"h-2 w-2 rounded-full bg-[var(--brand-red)]\" data-kid=\"1-1-2-1-1-2-2-1\" data-name=\"map indicator dot\">\n                            </span>\n                            Mapa de ubicación\n                        </div>\n                        <img alt=\"UNIDOSLAB\" class=\"absolute bottom-4 right-4 h-5 w-auto rounded bg-white/90 px-1.5 py-1 opacity-90 shadow-sm\" data-kid=\"1-1-2-1-1-2-3\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo-unidoslab.webp\"/>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 border-t border-slate-50 bg-slate-50/60 px-7 py-4 sm:px-8\" data-kid=\"1-1-2-1-2\" data-name=\"location footer bar\">\n                    <div class=\"flex items-center gap-2 text-slate-500\" data-kid=\"1-1-2-1-2-1\" data-name=\"opening hours container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock text-base text-[var(--brand-red)]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"clock icon\">\n                        </i>\n                        <span class=\"text-[11px] font-bold tracking-wide\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"opening hours text\">\n                            Abierto Lunes a Sábado 7:00 AM - 7:00 PM\n                        </span>\n                    </div>\n                    <a class=\"shrink-0 text-[11px] font-extrabold text-[var(--brand-red)] transition-colors hover:text-red-700\" data-kid=\"1-1-2-1-2-2\" data-name=\"directions link\" href=\"https://maps.app.goo.gl/HUAqRFnH5PYh8r1q6\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Cómo llegar\n                        <i aria-hidden=\"true\" class=\"ti ti-navigation text-xs\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"navigation icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n            <article class=\"overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-[0_15px_30px_-10px_rgba(0,0,0,0.04)] transition-shadow duration-300 hover:shadow-[0_20px_40px_-12px_rgba(229,35,32,0.14)]\" data-kid=\"1-1-2-2\" data-name=\"location card 02\">\n                <div class=\"grid min-h-[33rem] grid-cols-1 lg:grid-cols-[1.08fr_0.92fr]\" data-kid=\"1-1-2-2-1\" data-name=\"location card inner layout\">\n                    <div class=\"flex flex-col justify-between p-7 sm:p-8\" data-kid=\"1-1-2-2-1-1\" data-name=\"location details area\">\n                        <div data-kid=\"1-1-2-2-1-1-1\" data-name=\"location basic info container\">\n                            <div class=\"mb-5 flex items-start justify-between gap-4\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"header layout container\">\n                                <div data-kid=\"1-1-2-2-1-1-1-1-1\" data-name=\"location title block\">\n                                    <p class=\"mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-[var(--brand-red)]\" data-kid=\"1-1-2-2-1-1-1-1-1-1\" data-name=\"location label text\">\n                                        Sede 02\n                                    </p>\n                                    <h2 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold leading-tight text-slate-900 sm:text-3xl\" data-kid=\"1-1-2-2-1-1-1-1-1-2\" data-name=\"location name headline\">\n                                        Patricio Meléndez\n                                    </h2>\n                                </div>\n                                <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[var(--mist)] text-[var(--brand-red)]\" data-kid=\"1-1-2-2-1-1-1-1-2\" data-name=\"icon box container\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-building-hospital text-xl\" data-kid=\"1-1-2-2-1-1-1-1-2-1\" data-name=\"hospital building icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <div class=\"mb-7 flex items-start gap-2.5 text-slate-600\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"location address block\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin mt-0.5 shrink-0 text-xl text-[var(--brand-red)]\" data-kid=\"1-1-2-2-1-1-1-2-1\" data-name=\"map pin icon\">\n                                </i>\n                                <span class=\"text-sm font-medium leading-relaxed\" data-kid=\"1-1-2-2-1-1-1-2-2\" data-name=\"address text\">\n                                    Calle Patricio Meléndez, Tacna\n                                </span>\n                            </div>\n                            <div class=\"space-y-3\" data-kid=\"1-1-2-2-1-1-1-3\" data-name=\"amenities list container\">\n                                <div class=\"flex items-center gap-3 text-slate-600\" data-kid=\"1-1-2-2-1-1-1-3-1\" data-name=\"amenity item container\">\n                                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-50 text-[var(--brand-red)]\" data-kid=\"1-1-2-2-1-1-1-3-1-1\" data-name=\"amenity icon box\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-flask text-base\" data-kid=\"1-1-2-2-1-1-1-3-1-1-1\" data-name=\"flask icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-xs font-semibold\" data-kid=\"1-1-2-2-1-1-1-3-1-2\" data-name=\"amenity name text\">\n                                        Laboratorio Clínico\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center gap-3 text-slate-600\" data-kid=\"1-1-2-2-1-1-1-3-2\" data-name=\"amenity item container\">\n                                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600\" data-kid=\"1-1-2-2-1-1-1-3-2-1\" data-name=\"amenity icon box\">\n                                        <i aria-hidden=\"true\" class=\"ti ti-vaccine text-base\" data-kid=\"1-1-2-2-1-1-1-3-2-1-1\" data-name=\"vaccine icon\">\n                                        </i>\n                                    </span>\n                                    <span class=\"text-xs font-semibold\" data-kid=\"1-1-2-2-1-1-1-3-2-2\" data-name=\"amenity name text\">\n                                        Vacunas & Tomas\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <a class=\"mt-8 inline-flex w-fit items-center gap-2 rounded-xl bg-[var(--brand-red)] px-4 py-3 text-xs font-bold text-white shadow-sm shadow-red-200 transition-colors hover:bg-red-700\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"google maps CTA button\" href=\"https://maps.app.goo.gl/YY4MkEoko7847tmb9\" rel=\"noopener noreferrer\" target=\"_blank\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brand-google-maps text-base\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"google maps icon\">\n                            </i>\n                            Abrir en Google Maps\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-sm\" data-kid=\"1-1-2-2-1-1-2-2\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"relative min-h-[20rem] overflow-hidden bg-slate-100 lg:min-h-full\" data-kid=\"1-1-2-2-1-2\" data-name=\"map view container\">\n                        <iframe class=\"absolute inset-0 h-full w-full border-0\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"google maps embedded iframe\" data-reason=\"source URL updated to include zoom and map type parameters\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://maps.google.com/maps?q=Calle%20Patricio%20Mel%C3%A9ndez%2C%20Tacna%2C%20Per%C3%BA&t=m&z=15&output=embed\" title=\"Mapa de ubicación de la sede Patricio Meléndez\">\n                        </iframe>\n                        <div class=\"pointer-events-none absolute left-4 top-4 inline-flex items-center gap-2 rounded-lg border border-white/80 bg-white/90 px-3 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-700 shadow-sm backdrop-blur-sm\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"map label badge\">\n                            <span class=\"h-2 w-2 rounded-full bg-[var(--brand-red)]\" data-kid=\"1-1-2-2-1-2-2-1\" data-name=\"map indicator dot\">\n                            </span>\n                            Mapa de ubicación\n                        </div>\n                        <img alt=\"UNIDOSLAB\" class=\"absolute bottom-4 right-4 h-5 w-auto rounded bg-white/90 px-1.5 py-1 opacity-90 shadow-sm\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo-unidoslab.webp\"/>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between gap-4 border-t border-slate-50 bg-slate-50/60 px-7 py-4 sm:px-8\" data-kid=\"1-1-2-2-2\" data-name=\"location footer bar\">\n                    <div class=\"flex items-center gap-2 text-slate-500\" data-kid=\"1-1-2-2-2-1\" data-name=\"opening hours container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-clock text-base text-[var(--brand-red)]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"clock icon\">\n                        </i>\n                        <span class=\"text-[11px] font-bold tracking-wide\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"opening hours text\">\n                            Abierto Lunes a Sábado 7:00 AM - 7:00 PM\n                        </span>\n                    </div>\n                    <a class=\"shrink-0 text-[11px] font-extrabold text-[var(--brand-red)] transition-colors hover:text-red-700\" data-kid=\"1-1-2-2-2-2\" data-name=\"directions link\" href=\"https://maps.app.goo.gl/YY4MkEoko7847tmb9\" rel=\"noopener noreferrer\" target=\"_blank\">\n                        Cómo llegar\n                        <i aria-hidden=\"true\" class=\"ti ti-navigation text-xs\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"navigation icon\">\n                        </i>\n                    </a>\n                </div>\n            </article>\n        </div>\n    </div>\n</section>\n",
