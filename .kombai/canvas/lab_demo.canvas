      "html": "\n<main class=\"flex min-h-screen w-full overflow-x-clip bg-white font-['IBM_Plex_Sans'] select-none\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .glass-panel {\n      background: rgba(255, 255, 255, 0.65);\n      backdrop-filter: blur(16px);\n      -webkit-backdrop-filter: blur(16px);\n      border: 1px solid #E0FFFF;\n    }\n\n    /* Custom input focus effect */\n    .input-terminal:focus {\n      border-bottom-color: #007BA7;\n      padding-left: 4px;\n    }\n    \n    .input-terminal {\n      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n    }\n\n    /* Remove focus ring */\n    .input-terminal:focus-visible {\n      outline: none;\n    }\n\n    /* Custom cursor for lab feel */\n    body {\n      cursor: default;\n    }\n\n    .btn-tactile {\n      transition: none;\n    }\n  </style>\n\n  \n  <section class=\"relative hidden lg:flex w-1/2 flex-col justify-between p-16 bg-white overflow-hidden\" data-kid=\"2\">\n    \n    <div class=\"absolute -top-24 -left-24 w-96 h-96 bg-[#F0FFFF]/50 rounded-full blur-3xl\" data-kid=\"3\"></div>\n    <div class=\"absolute -bottom-24 -right-24 w-64 h-64 bg-[#007BA7]/5 rounded-full blur-3xl\" data-kid=\"4\"></div>\n\n    \n    <div class=\"animate-entry relative z-20 flex items-center gap-5\" data-kid=\"5\">\n      <div class=\"relative flex items-center justify-center\" data-kid=\"6\">\n        <div class=\"absolute w-12 h-12 rounded-full bg-[#007BA7]/10 animate-pulse\" data-kid=\"7\"></div>\n        <div class=\"relative w-10 h-10 border border-[#007BA7]/30 flex items-center justify-center rotate-45\" data-kid=\"8\">\n          <i class=\"ti ti-hexagon text-[#007BA7] text-2xl -rotate-45\" data-kid=\"9\"></i>\n        </div>\n      </div>\n      <div data-kid=\"10\">\n        <h1 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-2xl tracking-tighter text-slate-800 leading-none\" data-kid=\"11\">AQUA<span class=\"text-[#007BA7]\" data-kid=\"12\">LAB</span></h1>\n        <p class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400 mt-1\" data-kid=\"13\">Clinical Operations</p>\n      </div>\n    </div>\n\n    \n    <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden\" data-kid=\"14\">\n      <div id=\"molecule-container\" class=\"relative w-full h-full flex items-center justify-center\" data-kid=\"15\">\n        \n        <div class=\"absolute top-[30%] left-[35%] w-4 h-4 border border-[#007BA7]/40 rounded-full animate-ping z-20\" data-kid=\"16\"></div>\n        <div class=\"absolute bottom-[40%] right-[30%] w-3 h-3 border border-[#007BA7]/30 rounded-xs rotate-45 animate-pulse z-20\" data-kid=\"17\"></div>\n        <div class=\"absolute top-[45%] right-[25%] flex flex-col gap-1 z-20 opacity-40\" data-kid=\"18\">\n          <div class=\"w-8 h-[1px] bg-[#007BA7]\" data-kid=\"19\"></div>\n          <span class=\"text-[8px] font-bold text-[#007BA7] uppercase tracking-tighter\" data-kid=\"20\">Chain_A:742</span>\n        </div>\n        \n        <img id=\"molecule-main\" src=\"https://images.unsplash.com/photo-1773984203491-7262e4b9284f?auto=format&w=1600&q=90&fit=crop\" alt=\"3D Molecular Protein Logan Voss\" class=\"w-[110%] max-w-none h-auto object-contain mix-blend-multiply opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"21\">\n      </div>\n    </div>\n\n    \n    <div class=\"relative z-20\" data-kid=\"22\">\n      <div class=\"flex flex-col gap-2\" data-kid=\"23\">\n        <div class=\"animate-entry w-12 h-[2px] bg-[#007BA7]\" data-kid=\"24\"></div>\n        <h3 class=\"animate-entry font-['Plus_Jakarta_Sans'] font-bold text-slate-700 max-w-xs text-lg\" data-kid=\"25\">\n          Laboratory Operations & <br data-kid=\"26\"> Client Management System\n        </h3>\n        <p class=\"animate-entry text-xs text-slate-400 font-medium\" data-kid=\"27\">Internal System v4.8.2 // Secure Cluster B</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"w-full lg:w-1/2 flex items-center justify-center bg-white p-8 relative overflow-hidden\" data-kid=\"28\">\n    \n    <div class=\"absolute inset-0 opacity-[0.03] pointer-events-none\" style=\"background-image: linear-gradient(#007BA7 1px, transparent 1px), linear-gradient(90deg, #007BA7 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"29\"></div>\n\n    \n    <div id=\"login-form-container\" class=\"w-full max-w-md glass-panel p-12 lg:p-14 relative z-10 shadow-[0_30px_60px_-15px_rgba(0,123,167,0.08)] border border-[#E0FFFF]/50 rounded-xs\" data-kid=\"30\">\n      \n      <header class=\"mb-12\" data-kid=\"31\">\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-[#F0FFFF] border border-[#E0FFFF] mb-4\" data-kid=\"32\">\n          <span class=\"w-1.5 h-1.5 bg-[#007BA7] rounded-full\" data-kid=\"33\"></span>\n          <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#007BA7]\" data-kid=\"34\">Secure Terminal</span>\n        </div>\n        <h2 class=\"font-['Plus_Jakarta_Sans'] text-4xl font-extrabold text-slate-900 tracking-tight leading-tight\" data-kid=\"35\">Access Terminal</h2>\n        <p class=\"text-slate-500 mt-3 text-sm font-medium leading-relaxed\" data-kid=\"36\">Please authenticate with your Laboratory credentials to initiate session.</p>\n      </header>\n\n      <form class=\"space-y-8\" data-kid=\"37\">\n        \n        <div class=\"group relative\" data-kid=\"38\">\n          <label class=\"text-[10px] uppercase tracking-[0.2em] text-slate-400 font-bold mb-2 block group-focus-within:text-[#007BA7] transition-colors\" data-kid=\"39\">Scientist ID</label>\n          <div class=\"relative\" data-kid=\"40\">\n            <input type=\"text\" value=\"L-724-SC-K\" class=\"input-terminal w-full py-4 bg-transparent border-b-2 border-slate-100 outline-none text-slate-800 font-semibold tracking-wide placeholder:text-slate-300 transition-all\" placeholder=\"Enter ID...\" data-kid=\"41\">\n            <i class=\"ti ti-user-check absolute right-0 bottom-4 text-slate-300 group-focus-within:text-[#007BA7] transition-colors\" data-kid=\"42\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"group relative\" data-kid=\"43\">\n          <label class=\"text-[10px] uppercase tracking-[0.2em] text-slate-400 font-bold mb-2 block group-focus-within:text-[#007BA7] transition-colors\" data-kid=\"44\">Passcode</label>\n          <div class=\"relative\" data-kid=\"45\">\n            <input type=\"password\" value=\"••••••••\" class=\"input-terminal w-full py-4 bg-transparent border-b-2 border-slate-100 outline-none text-slate-800 font-semibold placeholder:text-slate-300 transition-all\" placeholder=\"••••••••\" data-kid=\"46\">\n            <i class=\"ti ti-lock-access absolute right-0 bottom-4 text-slate-300 group-focus-within:text-[#007BA7] transition-colors\" data-kid=\"47\"></i>\n          </div>\n        </div>\n\n        \n        <div class=\"pt-4\" data-kid=\"48\">\n          <button type=\"button\" id=\"submit-btn\" class=\"btn-tactile w-full bg-[#007BA7] text-white py-5 px-8 font-extrabold uppercase tracking-[0.2em] text-xs shadow-lg shadow-[#007BA7]/20 hover:bg-[#006a91] flex items-center justify-center gap-3 cursor-pointer group\" data-kid=\"49\">\n            Authorize Access\n            <i class=\"ti ti-chevron-right text-base transition-transform group-hover:translate-x-1\" data-kid=\"50\"></i>\n          </button>\n        </div>\n      </form>\n\n      <footer class=\"mt-12 pt-8 border-t border-slate-50 flex items-center justify-between\" data-kid=\"51\">\n        <button class=\"text-[11px] text-slate-400 font-bold uppercase tracking-widest hover:text-[#007BA7] transition-colors cursor-pointer\" data-kid=\"52\">\n          Reset Passcode\n        </button>\n        <button class=\"text-[11px] text-[#007BA7] font-bold uppercase tracking-widest hover:underline decoration-2 underline-offset-4 cursor-pointer\" data-kid=\"53\">\n          Emergency Port\n        </button>\n      </footer>\n    </div>\n\n    \n    <div class=\"absolute bottom-8 lg:hidden flex items-center gap-3\" data-kid=\"54\">\n      <i class=\"ti ti-hexagon text-[#007BA7] text-xl\" data-kid=\"55\"></i>\n      <span class=\"font-['Plus_Jakarta_Sans'] font-bold text-slate-800 text-sm tracking-tight\" data-kid=\"56\">AQUALAB</span>\n    </div>\n  </section>\n\n  \n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"57\"></script>\n  <script type=\"module\" data-kid=\"58\">\n    import { animate } from 'https://esm.sh/animejs@4';\n\n    // GSAP Entrance: Slide in from right for form\n    gsap.from(\"#login-form-container\", {\n      autoAlpha: 0,\n      xPercent: 20,\n      duration: 1.2,\n      ease: \"power4.out\",\n      delay: 0.2\n    });\n\n    // GSAP Entrance: Fade in for left content\n    gsap.from(\".animate-entry\", {\n      autoAlpha: 0,\n      y: 15,\n      stagger: 0.08,\n      duration: 0.9,\n      ease: \"power2.out\"\n    });\n\n    // Anime.js: Ambient Float for Molecule\n    animate(\"#molecule-main\", {\n      y: [-15, 15],\n      rotate: [0, 2],\n      scale: [1, 1.02],\n      duration: 4000,\n      direction: 'alternate',\n      loop: true,\n      easing: 'easeInOutQuad'\n    });\n\n    // Anime.js: Tactile Lift for Button\n    const btn = document.getElementById('submit-btn');\n    btn.addEventListener(\"pointerenter\", () => {\n      animate(btn, { \n        y: -4, \n        scale: 1.01, \n        backgroundColor: '#006a91',\n        duration: 300, \n        easing: 'easeOutQuad' \n      });\n    });\n    btn.addEventListener(\"pointerleave\", () => {\n      animate(btn, { \n        y: 0, \n        scale: 1, \n        backgroundColor: '#007BA7',\n        duration: 400, \n        easing: 'easeOutQuad' \n      });\n    });\n\n    // Interactive Molecules (Subtle movement based on cursor)\n    document.addEventListener('mousemove', (e) => {\n      const x = (e.clientX - window.innerWidth / 4) / 50;\n      const y = (e.clientY - window.innerHeight / 2) / 50;\n      gsap.to(\"#molecule-container\", {\n        x: x,\n        y: y,\n        duration: 2,\n        ease: \"power2.out\"\n      });\n    });\n  </script>\n</main>\n",
