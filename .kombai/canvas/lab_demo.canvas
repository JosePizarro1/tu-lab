      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-[#f7f9fc] font-['IBM_Plex_Sans'] text-slate-700\" data-kid=\"1\" data-name=\"main page container\" style=\"font-family:'IBM Plex Sans', sans-serif;\">\n    <header class=\"border-b border-slate-200/70 bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1140px] items-center justify-between gap-8 px-6\" data-kid=\"1-1-1\" data-name=\"top navigation bar container\">\n            <img alt=\"UNIDOSLAB - Unidos por tu Salud\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1\" data-name=\"UNIDOSLAB brand logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo-unidoslab.webp\"/>\n            <div class=\"relative w-full max-w-[520px]\" data-kid=\"1-1-1-2\" data-name=\"search input container\">\n                <input aria-label=\"Buscar en UNIDOSLAB\" class=\"h-11 w-full rounded-full border border-slate-200/80 bg-slate-50/80 pl-12 pr-5 text-sm font-medium text-slate-700 outline-none placeholder:text-slate-400 focus:border-red-200 focus:bg-white focus:ring-4 focus:ring-red-100/60\" data-kid=\"1-1-1-2-1\" data-name=\"search input field\" placeholder=\"Busque exámenes, sedes, etc...\" type=\"search\"/>\n                <i aria-hidden=\"true\" class=\"ti ti-search absolute left-5 top-1/2 -translate-y-1/2 text-xl text-slate-400\" data-kid=\"1-1-1-2-2\" data-name=\"search icon\">\n                </i>\n            </div>\n            <div class=\"w-[190px]\" data-kid=\"1-1-1-3\" data-name=\"header spacer\">\n            </div>\n        </div>\n        <nav aria-label=\"Navegación principal\" class=\"border-t border-slate-100/90\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <div class=\"mx-auto flex h-[58px] max-w-[1140px] items-center justify-center\" data-kid=\"1-1-2-1\" data-name=\"navigation bar wrapper\">\n                <ul class=\"flex h-full items-center gap-10\" data-kid=\"1-1-2-1-1\" data-name=\"navigation menu list\">\n                    <li data-kid=\"1-1-2-1-1-1\" data-name=\"inicio navigation link\">\n                        <button class=\"relative flex h-full items-center px-3 text-sm font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-900\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"inicio button\">\n                            Inicio\n                        </button>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-2\" data-name=\"servicios navigation link\">\n                        <button class=\"relative flex h-full items-center gap-2 px-3 text-sm font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-900\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"servicios button\">\n                            Servicios\n                            <span class=\"text-[10px]\" data-kid=\"1-1-2-1-1-2-1-1\" data-name=\"dropdown arrow icon\">\n                                ▼\n                            </span>\n                        </button>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-3\" data-name=\"soy médico navigation link\">\n                        <button class=\"relative flex h-full items-center px-3 text-sm font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-900\" data-kid=\"1-1-2-1-1-3-1\" data-name=\"soy médico button\">\n                            Soy Médico\n                        </button>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-4\" data-name=\"sedes navigation link\">\n                        <button class=\"relative flex h-full items-center px-3 text-sm font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-900\" data-kid=\"1-1-2-1-1-4-1\" data-name=\"sedes button\">\n                            Sedes\n                        </button>\n                    </li>\n                    <li data-kid=\"1-1-2-1-1-5\" data-name=\"resultados navigation link\">\n                        <button aria-current=\"page\" class=\"relative flex h-full items-center px-3 text-sm font-bold uppercase tracking-[0.12em] text-[#E52320] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-[3px] after:rounded-t-full after:bg-[#E52320]\" data-kid=\"1-1-2-1-1-5-1\" data-name=\"resultados button\">\n                            Resultados\n                        </button>\n                    </li>\n                </ul>\n            </div>\n        </nav>\n    </header>\n    <main class=\"min-h-[calc(100vh-134px)] bg-[radial-gradient(circle_at_top,rgba(229,35,32,0.04),transparent_34rem)] px-4 py-12 sm:px-6 lg:py-[68px]\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"analysis-title\" class=\"relative mx-auto w-full max-w-[900px] overflow-hidden rounded-[24px] border border-slate-200/80 bg-white p-6 shadow-[0_24px_60px_-34px_rgba(15,23,42,0.34)] sm:p-9 lg:p-11\" data-kid=\"1-2-1\" data-name=\"analysis report section\">\n            <div aria-hidden=\"true\" class=\"absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#E52320] via-red-400 to-amber-300\" data-kid=\"1-2-1-1\" data-name=\"report top decorative gradient bar\">\n            </div>\n            <div class=\"flex flex-col gap-5 border-b border-slate-200 pb-8 sm:flex-row sm:items-start sm:justify-between\" data-kid=\"1-2-1-2\" data-name=\"report header info container\">\n                <div data-kid=\"1-2-1-2-1\" data-name=\"report title and metadata container\">\n                    <div class=\"mb-3 inline-flex items-center gap-2 rounded-full border border-red-100 bg-red-50/70 px-2.5 py-1 text-[10px] font-bold tracking-[0.12em] text-[#E52320]\" data-kid=\"1-2-1-2-1-1\" data-name=\"report category container\">\n                        <span aria-hidden=\"true\" class=\"flex h-5 w-5 items-center justify-center rounded-full bg-white text-[#E52320] shadow-xs\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"report category icon container\">\n                            <i class=\"ti ti-file-certificate text-xs\" data-kid=\"1-2-1-2-1-1-1-1\" data-name=\"file certificate icon\">\n                            </i>\n                        </span>\n                        Informe clínico\n                    </div>\n                    <h1 class=\"font-['Plus_Jakarta_Sans'] text-[30px] font-extrabold leading-tight tracking-[-0.04em] text-slate-950 sm:text-[34px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"analysis report headline\" id=\"analysis-title\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                        Resultado de Análisis\n                    </h1>\n                    <p class=\"mt-2 text-sm font-medium text-slate-500\" data-kid=\"1-2-1-2-1-3\" data-name=\"document identifier container\">\n                        Documento:\n                        <span class=\"font-bold text-[#1E3A4C]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"document id value\" data-reason=\"content rendered dynamically from database\">\n                            70855\n                        </span>\n                    </p>\n                </div>\n                <button class=\"inline-flex w-fit items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-600 shadow-xs transition-all hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900 focus:outline-none focus:ring-4 focus:ring-red-100\" data-kid=\"1-2-1-2-2\" data-name=\"nueva consulta call-to-action button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-refresh text-base\" data-kid=\"1-2-1-2-2-1\" data-name=\"refresh icon\">\n                    </i>\n                    Nueva Consulta\n                </button>\n            </div>\n            <div class=\"mt-8 grid grid-cols-1 gap-5 rounded-2xl border border-slate-100 bg-[#f8fafc] px-5 py-5 sm:grid-cols-2 sm:px-6\" data-kid=\"1-2-1-3\" data-name=\"patient and date info container\">\n                <div data-kid=\"1-2-1-3-1\" data-name=\"patient name container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#8da2be]\" data-kid=\"1-2-1-3-1-1\" data-name=\"patient name label\">\n                        Paciente\n                    </p>\n                    <p class=\"mt-2 text-sm font-bold text-[#1E3A4C]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-2\" data-name=\"patient name\" data-reason=\"content rendered dynamically from database\">\n                        JUAN PÉREZ GARCÍA\n                    </p>\n                </div>\n                <div class=\"sm:text-right\" data-kid=\"1-2-1-3-2\" data-name=\"emission date container\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#8da2be]\" data-kid=\"1-2-1-3-2-1\" data-name=\"emission date label\">\n                        Fecha de emisión\n                    </p>\n                    <p class=\"mt-2 text-sm font-bold text-[#1E3A4C]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-2-2\" data-name=\"emission date value\" data-reason=\"content rendered dynamically from database\">\n                        03/07/2026\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 overflow-hidden rounded-2xl border border-slate-200/80 bg-white\" data-kid=\"1-2-1-4\" data-name=\"results table container\">\n                <div class=\"overflow-x-auto\" data-kid=\"1-2-1-4-2\" data-name=\"results table wrapper\">\n                    <table class=\"min-w-[640px] w-full border-collapse text-sm text-left\" data-kid=\"1-2-1-4-2-1\" data-name=\"clinical analysis table\">\n                        <thead data-kid=\"1-2-1-4-2-1-1\" data-name=\"table header row\">\n                            <tr class=\"border-b border-slate-100 bg-slate-50/80 text-[10px] font-bold tracking-[0.08em] text-slate-500\" data-kid=\"1-2-1-4-2-1-1-1\" data-name=\"header column row\">\n                                <th class=\"px-5 py-4\" data-kid=\"1-2-1-4-2-1-1-1-1\" data-name=\"examen header label\">\n                                    Examen\n                                </th>\n                                <th class=\"px-5 py-4\" data-kid=\"1-2-1-4-2-1-1-1-2\" data-name=\"resultado header label\">\n                                    Resultado\n                                </th>\n                                <th class=\"px-5 py-4\" data-kid=\"1-2-1-4-2-1-1-1-3\" data-name=\"unidades header label\">\n                                    Unidades\n                                </th>\n                                <th class=\"px-5 py-4\" data-kid=\"1-2-1-4-2-1-1-1-4\" data-name=\"referencia header label\">\n                                    Valores de referencia\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-slate-100\" data-kid=\"1-2-1-4-2-1-2\" data-name=\"table body\">\n                            <tr class=\"bg-white transition-colors hover:bg-slate-50/70\" data-kid=\"1-2-1-4-2-1-2-1\" data-name=\"hemoglobina table row\">\n                                <td class=\"px-5 py-5 font-bold text-[#1E3A4C]\" data-kid=\"1-2-1-4-2-1-2-1-1\" data-name=\"hemoglobina name\">\n                                    Hemoglobina\n                                </td>\n                                <td class=\"px-5 py-5 font-bold text-slate-900\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2-1-2-1-2\" data-name=\"hemoglobin value\" data-reason=\"content rendered dynamically from database\">\n                                    14.5\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-600\" data-kid=\"1-2-1-4-2-1-2-1-3\" data-name=\"hemoglobina units\">\n                                    g/dL\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-400\" data-kid=\"1-2-1-4-2-1-2-1-4\" data-name=\"hemoglobina reference\">\n                                    13.8 - 17.2\n                                </td>\n                            </tr>\n                            <tr class=\"bg-white transition-colors hover:bg-slate-50/70\" data-kid=\"1-2-1-4-2-1-2-2\" data-name=\"glucosa table row\">\n                                <td class=\"px-5 py-5 font-bold text-[#1E3A4C]\" data-kid=\"1-2-1-4-2-1-2-2-1\" data-name=\"glucosa name\">\n                                    Glucosa en Ayunas\n                                </td>\n                                <td class=\"px-5 py-5 font-bold text-slate-900\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2-1-2-2-2\" data-name=\"glucose value\" data-reason=\"content rendered dynamically from database\">\n                                    85\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-600\" data-kid=\"1-2-1-4-2-1-2-2-3\" data-name=\"glucosa units\">\n                                    mg/dL\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-400\" data-kid=\"1-2-1-4-2-1-2-2-4\" data-name=\"glucosa reference\">\n                                    70 - 100\n                                </td>\n                            </tr>\n                            <tr class=\"bg-white transition-colors hover:bg-slate-50/70\" data-kid=\"1-2-1-4-2-1-2-3\" data-name=\"colesterol table row\">\n                                <td class=\"px-5 py-5 font-bold text-[#1E3A4C]\" data-kid=\"1-2-1-4-2-1-2-3-1\" data-name=\"colesterol name\">\n                                    Colesterol Total\n                                </td>\n                                <td class=\"px-5 py-5 font-bold text-slate-900\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2-1-2-3-2\" data-name=\"cholesterol value\" data-reason=\"content rendered dynamically from database\">\n                                    198\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-600\" data-kid=\"1-2-1-4-2-1-2-3-3\" data-name=\"colesterol units\">\n                                    mg/dL\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-400\" data-kid=\"1-2-1-4-2-1-2-3-4\" data-name=\"colesterol reference\">\n                                    < 200\n                                </td>\n                            </tr>\n                            <tr class=\"bg-white transition-colors hover:bg-slate-50/70\" data-kid=\"1-2-1-4-2-1-2-4\" data-name=\"triglicéridos table row\">\n                                <td class=\"px-5 py-5 font-bold text-[#1E3A4C]\" data-kid=\"1-2-1-4-2-1-2-4-1\" data-name=\"triglicéridos name\">\n                                    Triglicéridos\n                                </td>\n                                <td class=\"px-5 py-5 font-bold text-slate-900\" data-dynamic=\"true\" data-kid=\"1-2-1-4-2-1-2-4-2\" data-name=\"triglycerides value\" data-reason=\"content rendered dynamically from database\">\n                                    135\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-600\" data-kid=\"1-2-1-4-2-1-2-4-3\" data-name=\"triglicéridos units\">\n                                    mg/dL\n                                </td>\n                                <td class=\"px-5 py-5 text-slate-400\" data-kid=\"1-2-1-4-2-1-2-4-4\" data-name=\"triglicéridos reference\">\n                                    < 150\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n            <div class=\"mt-8 flex justify-end\" data-kid=\"1-2-1-5\" data-name=\"download report action container\">\n                <button class=\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#E52320] px-6 py-4 text-xs font-extrabold tracking-[0.08em] text-white shadow-[0_10px_24px_-14px_rgba(15,23,42,0.8)] transition-all hover:-translate-y-0.5 hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100 sm:w-auto\" data-kid=\"1-2-1-5-1\" data-name=\"download pdf button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-download text-base\" data-kid=\"1-2-1-5-1-1\" data-name=\"download icon\">\n                    </i>\n                    Descargar Reporte PDF\n                </button>\n            </div>\n        </section>\n    </main>\n    <a aria-label=\"Contactar por WhatsApp\" class=\"fixed bottom-7 right-7 z-20 inline-flex items-center gap-3 rounded-full bg-emerald-500 px-5 py-4 text-sm font-bold tracking-[0.08em] text-white shadow-[0_12px_24px_-14px_rgba(15,23,42,0.72)] transition-all hover:-translate-y-0.5 hover:bg-emerald-600 focus:outline-none focus:ring-4 focus:ring-emerald-100\" data-kid=\"1-3\" data-name=\"whatsapp floating button\" href=\"#\">\n        <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp text-2xl\" data-kid=\"1-3-1\" data-name=\"whatsapp icon\">\n        </i>\n        <span data-kid=\"1-3-2\" data-name=\"whatsapp text label\">\n            WhatsApp\n        </span>\n    </a>\n</div>\n",
