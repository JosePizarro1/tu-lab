      "html": "<main class=\"min-h-screen bg-white font-['IBM_Plex_Sans'] select-none relative overflow-hidden\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --cerulean: #007BA7;\n      --azure-mist: #F0FFFF;\n      --lab-border: #E0FFFF;\n    }\n\n    .blueprint-grid {\n      background-color: #ffffff;\n      background-image: \n        linear-gradient(var(--lab-border) 1px, transparent 1px),\n        linear-gradient(90deg, var(--lab-border) 1px, transparent 1px),\n        linear-gradient(rgba(224, 255, 255, 0.3) 0.5px, transparent 0.5px),\n        linear-gradient(90deg, rgba(224, 255, 255, 0.3) 0.5px, transparent 0.5px);\n      background-size: 50px 50px, 50px 50px, 10px 10px, 10px 10px;\n    }\n\n    .matrix-cell {\n      position: relative;\n      transition: background-color 0s; /* Instant swap */\n    }\n\n    .matrix-cell::before {\n      content: '';\n      position: absolute;\n      left: 0;\n      top: 0;\n      bottom: 0;\n      width: 4px;\n      background-color: var(--cerulean);\n      opacity: 0;\n      transition: opacity 0s;\n    }\n\n    .matrix-cell:hover {\n      background-color: var(--azure-mist);\n    }\n\n    .matrix-cell:hover::before {\n      opacity: 1;\n    }\n\n    .blinking-cursor {\n      display: inline-block;\n      width: 8px;\n      height: 1.2em;\n      background-color: var(--cerulean);\n      margin-left: 4px;\n      vertical-align: middle;\n      animation: blink 1s step-end infinite;\n    }\n\n    @keyframes blink {\n      from, to { opacity: 1; }\n      50% { opacity: 0; }\n    }\n\n    .mono {\n      font-family: 'IBM Plex Mono', monospace;\n    }\n  </style>\n\n  <div class=\"blueprint-grid min-h-screen flex flex-col\" data-kid=\"2\">\n    \n    <header class=\"w-full border-b border-[var(--lab-border)] bg-white/80 backdrop-blur-md px-10 h-20 flex items-center justify-between sticky top-0 z-50\" data-kid=\"3\">\n      <div class=\"flex items-center gap-8\" data-kid=\"4\">\n        <div class=\"flex items-center gap-3\" data-kid=\"5\">\n          <div class=\"w-8 h-8 border border-[var(--cerulean)]/30 flex items-center justify-center rotate-45\" data-kid=\"6\">\n            <i class=\"ti ti-hexagon text-[var(--cerulean)] text-lg -rotate-45\" data-kid=\"7\"></i>\n          </div>\n          <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl tracking-tighter text-slate-800\" data-kid=\"8\">AQUALAB</span>\n        </div>\n        \n        <div class=\"h-8 w-[1px] bg-[var(--lab-border)]\" data-kid=\"9\"></div>\n        \n        <nav data-kid=\"10\">\n          <ul class=\"flex items-center gap-6 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-400\" data-kid=\"11\">\n            <li data-kid=\"12\"><a href=\"#\" class=\"hover:text-[var(--cerulean)] transition-colors\" data-kid=\"13\">System</a></li>\n            <li data-kid=\"14\"><a href=\"#\" class=\"text-[var(--cerulean)]\" data-kid=\"15\">Services</a></li>\n            <li data-kid=\"16\"><a href=\"#\" class=\"hover:text-[var(--cerulean)] transition-colors\" data-kid=\"17\">Network</a></li>\n          </ul>\n        </nav>\n      </div>\n\n      <div class=\"flex-1 max-w-xl mx-12 relative\" data-kid=\"18\">\n        <input type=\"text\" placeholder=\"QUERY_ANALYSIS_DATABASE...\" class=\"w-full pl-10 pr-4 py-2 bg-slate-50/50 border border-[var(--lab-border)] text-xs font-bold uppercase tracking-widest text-slate-600 focus:outline-none focus:border-[var(--cerulean)] transition-all\" data-kid=\"19\">\n        <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" data-kid=\"20\"></i>\n      </div>\n\n      <div class=\"flex items-center gap-4 text-slate-400\" data-kid=\"21\">\n        <i class=\"ti ti-bell-ringing text-lg cursor-pointer hover:text-[var(--cerulean)]\" data-kid=\"22\"></i>\n        <div class=\"w-8 h-8 rounded-full bg-slate-100 border border-[var(--lab-border)] flex items-center justify-center cursor-pointer\" data-kid=\"23\">\n          <i class=\"ti ti-user text-sm\" data-kid=\"24\"></i>\n        </div>\n      </div>\n    </header>\n\n    \n    <div class=\"flex-1 px-10 py-16\" data-kid=\"25\">\n      \n      <section class=\"mb-16\" data-kid=\"26\">\n        <div class=\"bg-white/90 p-10 border border-[var(--lab-border)] shadow-sm max-w-4xl relative overflow-hidden\" data-kid=\"27\">\n          <div class=\"absolute top-0 right-0 p-4 opacity-10\" data-kid=\"28\">\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/laser-precision.svg\" class=\"w-32 h-32\" data-kid=\"29\">\n          </div>\n          \n          <div class=\"flex items-center gap-2 mb-4\" data-kid=\"30\">\n            <span class=\"text-[10px] font-bold text-[var(--cerulean)] uppercase tracking-widest bg-[var(--azure-mist)] px-2 py-0.5 border border-[var(--lab-border)]\" data-kid=\"31\">Status: ACTIVE</span>\n            <span class=\"text-[10px] font-mono text-slate-400\" data-kid=\"32\">REF_ID: LIMS-2026-SRV</span>\n          </div>\n          \n          <h1 class=\"font-['Plus_Jakarta_Sans'] text-6xl font-extrabold text-slate-900 tracking-tight leading-none mb-6\" data-kid=\"33\">\n            Nuestros Servicios<span class=\"blinking-cursor\" data-kid=\"34\"></span>\n          </h1>\n          \n          <p class=\"text-slate-500 text-lg font-medium leading-relaxed max-w-2xl\" data-kid=\"35\">\n            Implementación de matriz diagnóstica de alta fidelidad. Catálogo estandarizado para operaciones clínicas y gestión de clientes.\n          </p>\n          \n          <div class=\"mt-8 flex gap-8\" data-kid=\"36\">\n            <div class=\"flex flex-col\" data-kid=\"37\">\n              <span class=\"text-[9px] font-bold uppercase text-slate-400 tracking-tighter\" data-kid=\"38\">Precision_Rate</span>\n              <span class=\"text-xl font-mono font-bold text-slate-800\" data-kid=\"39\">99.98%</span>\n            </div>\n            <div class=\"flex flex-col\" data-kid=\"40\">\n              <span class=\"text-[9px] font-bold uppercase text-slate-400 tracking-tighter\" data-kid=\"41\">Response_Time</span>\n              <span class=\"text-xl font-mono font-bold text-slate-800\" data-kid=\"42\">< 24HR</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"bg-white border border-[var(--lab-border)] shadow-2xl\" data-kid=\"43\">\n        <div class=\"grid grid-cols-3\" data-kid=\"44\">\n          \n          <div class=\"matrix-cell p-10 border-r border-b border-[var(--lab-border)] h-80 flex flex-col justify-between\" data-kid=\"45\">\n            <div class=\"flex justify-between items-start\" data-kid=\"46\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"47\">#01</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"48\">\n                <i class=\"ti ti-microscope text-[var(--cerulean)] text-2xl\" data-kid=\"49\"></i>\n              </div>\n            </div>\n            <div data-kid=\"50\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"51\">Inmunología</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"52\">\n                Análisis avanzado de anticuerpos y respuesta inmune. Marcadores tumorales de alta especificidad.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"matrix-cell p-10 border-r border-b border-[var(--lab-border)] h-80 flex flex-col justify-between\" data-kid=\"53\">\n            <div class=\"flex justify-between items-start\" data-kid=\"54\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"55\">#02</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"56\">\n                <i class=\"ti ti-flask text-[var(--cerulean)] text-2xl\" data-kid=\"57\"></i>\n              </div>\n            </div>\n            <div data-kid=\"58\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"59\">Bioquímica Clínica</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"60\">\n                Determinación cuantitativa de analitos en fluidos biológicos mediante sistemas automatizados.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"matrix-cell p-10 border-b border-[var(--lab-border)] h-80 flex flex-col justify-between\" data-kid=\"61\">\n            <div class=\"flex justify-between items-start\" data-kid=\"62\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"63\">#03</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"64\">\n                <i class=\"ti ti-droplets text-[var(--cerulean)] text-2xl\" data-kid=\"65\"></i>\n              </div>\n            </div>\n            <div data-kid=\"66\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"67\">Hematología</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"68\">\n                Estudio integral de elementos figurados de la sangre y mecanismos de hemostasia.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"matrix-cell p-10 border-r border-[var(--lab-border)] h-80 flex flex-col justify-between\" data-kid=\"69\">\n            <div class=\"flex justify-between items-start\" data-kid=\"70\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"71\">#04</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"72\">\n                <i class=\"ti ti-biohazard text-[var(--cerulean)] text-2xl\" data-kid=\"73\"></i>\n              </div>\n            </div>\n            <div data-kid=\"74\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"75\">Microbiología</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"76\">\n                Identificación fenotípica y genotípica de microorganismos patógenos.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"matrix-cell p-10 border-r border-[var(--lab-border)] h-80 flex flex-col justify-between\" data-kid=\"77\">\n            <div class=\"flex justify-between items-start\" data-kid=\"78\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"79\">#05</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"80\">\n                <i class=\"ti ti-dna text-[var(--cerulean)] text-2xl\" data-kid=\"81\"></i>\n              </div>\n            </div>\n            <div data-kid=\"82\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"83\">Biología Molecular</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"84\">\n                Amplificación de ácidos nucleicos para diagnóstico de enfermedades infecciosas y genéticas.\n              </p>\n            </div>\n          </div>\n\n          \n          <div class=\"matrix-cell p-10 h-80 flex flex-col justify-between\" data-kid=\"85\">\n            <div class=\"flex justify-between items-start\" data-kid=\"86\">\n              <span class=\"font-mono text-[10px] font-bold text-slate-300\" data-kid=\"87\">#06</span>\n              <div class=\"w-12 h-12 bg-[var(--azure-mist)] border border-[var(--lab-border)] flex items-center justify-center rounded-sm\" data-kid=\"88\">\n                <i class=\"ti ti-activity text-[var(--cerulean)] text-2xl\" data-kid=\"89\"></i>\n              </div>\n            </div>\n            <div data-kid=\"90\">\n              <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-bold text-slate-800 mb-4\" data-kid=\"91\">Ecografías</h3>\n              <p class=\"text-slate-500 text-sm leading-relaxed\" data-kid=\"92\">\n                Diagnóstico por imagen no invasivo con procesamiento digital de alta resolución.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    \n    <footer class=\"w-full bg-slate-900 px-10 py-6 border-t border-white/10 flex items-center justify-between text-[var(--azure-mist)]\" data-kid=\"93\">\n      <div class=\"flex gap-12\" data-kid=\"94\">\n        <div class=\"flex flex-col\" data-kid=\"95\">\n          <span class=\"text-[8px] font-bold uppercase text-slate-500 tracking-tighter\" data-kid=\"96\">Daily_Tests_Processed</span>\n          <span class=\"font-mono text-sm\" data-kid=\"97\">1,248_UNITS</span>\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"98\">\n          <span class=\"text-[8px] font-bold uppercase text-slate-500 tracking-tighter\" data-kid=\"99\">System_Uptime</span>\n          <span class=\"font-mono text-sm\" data-kid=\"100\">99.999%</span>\n        </div>\n        <div class=\"flex flex-col\" data-kid=\"101\">\n          <span class=\"text-[8px] font-bold uppercase text-slate-500 tracking-tighter\" data-kid=\"102\">Active_Nodes</span>\n          <span class=\"font-mono text-sm\" data-kid=\"103\">12_STATIONS</span>\n        </div>\n      </div>\n      \n      <div class=\"flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest text-slate-400\" data-kid=\"104\">\n        <span class=\"flex items-center gap-2\" data-kid=\"105\">\n          <span class=\"w-1.5 h-1.5 bg-green-500 rounded-full\" data-kid=\"106\"></span>\n          Server: LIMA-ST01\n        </span>\n        <span data-kid=\"107\">© 2026 AQUALAB CORE</span>\n      </div>\n    </footer>\n  </div>\n</main>",
