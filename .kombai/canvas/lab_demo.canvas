    "var_59443468da7e": {
      "type": "variant",
      "label": "Services: Asymmetrical Precision",
      "parentId": "var_2aed569e01f2",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<main class=\"min-h-screen bg-slate-50 font-['IBM_Plex_Sans'] text-slate-900 select-none pb-32\" data-kid=\"0\">\n  <style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --color-cerulean: #007BA7;\n      --color-azure-mist: #F0FFFF;\n      --color-lab-border: #E0FFFF;\n    }\n\n    .glass-panel {\n      background: rgba(255, 255, 255, 0.7);\n      backdrop-filter: blur(12px);\n      -webkit-backdrop-filter: blur(12px);\n      border: 1px solid var(--color-lab-border);\n    }\n\n    /* Asymmetrical Grid Offsets */\n    .stagger-grid > div:nth-child(3n+2) {\n      transform: translateY(40px);\n    }\n    .stagger-grid > div:nth-child(3n) {\n      transform: translateY(80px);\n    }\n\n    .service-card {\n      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n\n    .service-card:hover .arrow-slide {\n      transform: translateX(4px);\n      opacity: 1;\n    }\n\n    .arrow-slide {\n      transition: all 0.3s ease;\n      opacity: 0;\n      transform: translateX(-4px);\n    }\n\n    .hex-bg {\n      background-image: url('https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/honeycomb.svg');\n      background-size: 80px;\n      opacity: 0.04;\n    }\n  </style>\n\n  \n  <header class=\"sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-100\" data-kid=\"2\">\n    <div class=\"max-w-[1440px] mx-auto px-12 h-20 flex items-center justify-between\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3\" data-kid=\"4\">\n        <div class=\"w-8 h-8 border-2 border-[var(--color-cerulean)] rotate-45 flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-hexagon text-[var(--color-cerulean)] text-lg -rotate-45\" data-kid=\"6\"></i>\n        </div>\n        <div data-kid=\"7\">\n          <h1 class=\"font-['Plus_Jakarta_Sans'] font-extrabold text-xl tracking-tighter leading-none\" data-kid=\"8\">AQUA<span class=\"text-[var(--color-cerulean)]\" data-kid=\"9\">LAB</span></h1>\n          <p class=\"text-[8px] font-bold uppercase tracking-widest text-slate-400 mt-0.5\" data-kid=\"10\">Clinical Operations</p>\n        </div>\n      </div>\n\n      <div class=\"flex-1 max-w-[400px] relative mx-12\" data-kid=\"11\">\n        <input type=\"text\" placeholder=\"Busque exámenes...\" class=\"w-full py-2.5 px-4 bg-slate-50 border-b-2 border-slate-100 focus:border-[var(--color-cerulean)] outline-none text-sm transition-all duration-300\" data-kid=\"12\">\n        <i class=\"ti ti-search absolute right-0 top-1/2 -translate-y-1/2 text-slate-300\" data-kid=\"13\"></i>\n      </div>\n\n      <nav data-kid=\"14\">\n        <ul class=\"flex items-center gap-8 text-[11px] font-bold uppercase tracking-widest text-slate-500\" data-kid=\"15\">\n          <li data-kid=\"16\"><a href=\"#\" class=\"hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"17\">Inicio</a></li>\n          <li data-kid=\"18\"><a href=\"#\" class=\"text-[var(--color-cerulean)] border-b-2 border-[var(--color-cerulean)] pb-1\" data-kid=\"19\">Servicios</a></li>\n          <li data-kid=\"20\"><a href=\"#\" class=\"hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"21\">Sedes</a></li>\n          <li data-kid=\"22\"><a href=\"#\" class=\"hover:text-[var(--color-cerulean)] transition-colors\" data-kid=\"23\">Resultados</a></li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  \n  <section class=\"max-w-[1440px] mx-auto px-12 py-24 flex items-center gap-20\" data-kid=\"24\">\n    <div class=\"w-[60%]\" data-kid=\"25\">\n      <h2 class=\"font-['Plus_Jakarta_Sans'] text-8xl font-extrabold text-slate-900 tracking-tighter leading-[0.9]\" data-kid=\"26\">\n        Nuestros<br data-kid=\"27\">Servicios\n      </h2>\n      <div class=\"w-24 h-2.5 bg-[var(--color-cerulean)] my-12\" data-kid=\"28\"></div>\n      <p class=\"text-slate-500 text-xl font-medium max-w-lg leading-relaxed\" data-kid=\"29\">\n        Contamos con una amplia cartera de análisis y pruebas de diagnóstico con alta precisión, respaldada por tecnología de vanguardia.\n      </p>\n    </div>\n    \n    <div class=\"w-[40%] relative\" data-kid=\"30\">\n      <div class=\"absolute inset-0 bg-[var(--color-azure-mist)] rounded-[60%_40%_30%_70%/60%_30%_70%_40%] blur-3xl opacity-60\" data-kid=\"31\"></div>\n      <img src=\"https://images.unsplash.com/photo-1626428091984-48f9ffbf927c?auto=format&w=800&q=85&fit=crop\" alt=\"Microscopic structures\" class=\"relative z-10 w-full h-auto object-contain mix-blend-multiply filter hue-rotate-[180deg]\" data-kid=\"32\">\n    </div>\n  </section>\n\n  \n  <section class=\"max-w-[1440px] mx-auto px-12 py-20\" data-kid=\"33\">\n    <div class=\"stagger-grid grid grid-cols-3 gap-8\" data-kid=\"34\">\n      \n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"35\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"36\"></i>\n        <div class=\"relative z-10\" data-kid=\"37\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"38\">Pruebas hormonales, marcadores tumorales e infecciosos con la más alta sensibilidad analítica.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"39\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"40\">Inmunología</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"41\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"42\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"43\"></i>\n        <div class=\"relative z-10\" data-kid=\"44\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"45\">Perfiles metabólicos, renales, hepáticos y lípidos automatizados bajo estrictos controles de calidad.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"46\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"47\">Bioquímica Clínica</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"48\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"49\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"50\"></i>\n        <div class=\"relative z-10\" data-kid=\"51\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"52\">Hemogramas completos y estudios especiales de coagulación para diagnósticos hematológicos precisos.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"53\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"54\">Hematología</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"55\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"56\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"57\"></i>\n        <div class=\"relative z-10\" data-kid=\"58\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"59\">Cultivos bacterianos, identificación y antibiogramas rápidos para un tratamiento oportuno.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"60\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"61\">Microbiología</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"62\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"63\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"64\"></i>\n        <div class=\"relative z-10\" data-kid=\"65\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"66\">Detección por PCR de patógenos virales, estudios genéticos y tamizajes moleculares avanzados.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"67\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"68\">Biología Molecular</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"69\"></i>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"service-card group relative bg-white p-10 border border-transparent shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_50px_rgba(0,123,167,0.1)] hover:border-[var(--color-cerulean)] cursor-pointer overflow-hidden h-[340px] flex flex-col justify-end\" data-kid=\"70\">\n        <i class=\"ti ti-microscope absolute -top-4 -right-4 text-9xl text-[var(--color-cerulean)] opacity-[0.05] pointer-events-none group-hover:scale-110 transition-transform duration-700\" data-kid=\"71\"></i>\n        <div class=\"relative z-10\" data-kid=\"72\">\n          <p class=\"text-slate-500 mb-6 line-clamp-3\" data-kid=\"73\">Imágenes ecográficas en 3D/4D de alta definición realizadas por especialistas certificados.</p>\n          <div class=\"flex items-center gap-2\" data-kid=\"74\">\n            <h3 class=\"font-['Plus_Jakarta_Sans'] text-2xl font-extrabold tracking-tight\" data-kid=\"75\">Ecografías</h3>\n            <i class=\"ti ti-arrow-right text-[var(--color-cerulean)] arrow-slide\" data-kid=\"76\"></i>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  \n  <section class=\"max-w-[1440px] mx-auto px-12 mt-40\" data-kid=\"77\">\n    <div class=\"glass-panel relative p-16 overflow-hidden flex items-center justify-between\" data-kid=\"78\">\n      <div class=\"hex-bg absolute inset-0\" data-kid=\"79\"></div>\n      <div class=\"relative z-10\" data-kid=\"80\">\n        <h3 class=\"font-['Plus_Jakarta_Sans'] text-4xl font-extrabold tracking-tighter mb-4\" data-kid=\"81\">Accede a tus resultados en línea</h3>\n        <p class=\"text-slate-500 font-medium max-w-md\" data-kid=\"82\">Consulta el estado de tus análisis y descarga tus informes de forma segura desde nuestra plataforma.</p>\n      </div>\n      <button class=\"relative z-10 bg-[var(--color-cerulean)] text-white px-10 py-5 font-bold uppercase tracking-widest text-xs hover:bg-[#006a91] transition-colors shadow-lg shadow-[var(--color-cerulean)]/20\" data-kid=\"83\">\n        Portal de Resultados\n      </button>\n    </div>\n  </section>\n\n</main>",
