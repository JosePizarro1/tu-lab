      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-white font-['IBM_Plex_Sans'] text-[#1E3A4C]\" data-home-view=\"\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'IBM Plex Sans', sans-serif;\">\n    <header class=\"w-full border-b border-[#dbe4ea] bg-white\" data-home-header=\"\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[78px] max-w-[1180px] items-center justify-between gap-8 px-6\" data-kid=\"1-1-1\" data-name=\"header content wrapper\">\n            <a aria-label=\"UNIDOSLAB, ir al inicio\" class=\"shrink-0\" data-kid=\"1-1-1-1\" data-name=\"home link\" href=\"#inicio\">\n                <img alt=\"UNIDOSLAB - Unidos por tu Salud\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" data-name=\"UNIDOSLAB logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo-unidoslab.webp\"/>\n            </a>\n            <div class=\"relative hidden w-full max-w-[520px] md:block\" data-kid=\"1-1-1-2\" data-name=\"search input container\">\n                <label class=\"sr-only\" data-kid=\"1-1-1-2-1\" data-name=\"search input label\" for=\"home-search\">\n                    Buscar en UNIDOSLAB\n                </label>\n                <input aria-label=\"Buscar en UNIDOSLAB\" class=\"h-11 w-full border border-[#dbe4ea] bg-[#f8fafc] px-5 pl-12 text-sm font-medium text-[#1E3A4C] outline-none placeholder:text-[#8da2be] focus:border-[#E52320] focus:ring-2 focus:ring-[#E52320]\" data-kid=\"1-1-1-2-2\" data-name=\"search input field\" id=\"home-search\" placeholder=\"Busque exámenes, sedes, etc...\" type=\"search\"/>\n                <i aria-hidden=\"true\" class=\"ti ti-search pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-xl text-[#8da2be]\" data-kid=\"1-1-1-2-3\" data-name=\"search icon\">\n                </i>\n            </div>\n            <div class=\"w-10 md:hidden\" data-kid=\"1-1-1-3\" data-name=\"spacer element\">\n            </div>\n        </div>\n        <nav aria-label=\"Navegación principal\" class=\"border-t border-[#e8eef5] bg-white\" data-kid=\"1-1-2\" data-name=\"main navigation\">\n            <ul class=\"mx-auto flex h-[56px] max-w-[680px] items-stretch justify-center gap-1 px-4 sm:gap-4\" data-kid=\"1-1-2-1\" data-name=\"navigation list\">\n                <li data-kid=\"1-1-2-1-1\" data-name=\"inicio link\">\n                    <a aria-current=\"page\" class=\"relative flex h-full items-center border-b-4 border-[#E52320] px-4 text-xs font-bold uppercase tracking-[0.14em] text-[#E52320]\" data-kid=\"1-1-2-1-1-1\" data-name=\"inicio link text\" href=\"#inicio\">\n                        Inicio\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-2\" data-name=\"servicios menu link\">\n                    <a class=\"relative flex h-full items-center gap-1 border-b-4 border-transparent px-4 text-xs font-bold uppercase tracking-[0.14em] text-[#5f7590] hover:text-[#1E3A4C]\" data-kid=\"1-1-2-1-2-1\" data-name=\"servicios menu text\" href=\"#servicios\">\n                        Servicios\n                        <span class=\"text-[10px]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"dropdown arrow\">\n                            ▼\n                        </span>\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-3\" data-name=\"soy medico link\">\n                    <a class=\"relative flex h-full items-center border-b-4 border-transparent px-4 text-xs font-bold uppercase tracking-[0.14em] text-[#5f7590] hover:text-[#1E3A4C]\" data-kid=\"1-1-2-1-3-1\" data-name=\"soy medico link text\" href=\"#medico\">\n                        Soy Médico\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-4\" data-name=\"sedes link\">\n                    <a class=\"relative flex h-full items-center border-b-4 border-transparent px-4 text-xs font-bold uppercase tracking-[0.14em] text-[#5f7590] hover:text-[#1E3A4C]\" data-kid=\"1-1-2-1-4-1\" data-name=\"sedes link text\" href=\"#sedes\">\n                        Sedes\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-5\" data-name=\"resultados link\">\n                    <a class=\"relative flex h-full items-center border-b-4 border-transparent px-4 text-xs font-bold uppercase tracking-[0.14em] text-[#5f7590] hover:text-[#1E3A4C]\" data-kid=\"1-1-2-1-5-1\" data-name=\"resultados link text\" href=\"#resultados\">\n                        Resultados\n                    </a>\n                </li>\n            </ul>\n        </nav>\n    </header>\n    <main class=\"w-full bg-white\" data-home-main=\"\" data-kid=\"1-2\" data-name=\"main content area\" id=\"inicio\">\n        <section class=\"relative flex min-h-[520px] w-full items-center overflow-hidden bg-[#0f172a]\" data-home-hero=\"\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <img alt=\"Imagen de laboratorio de SumanLab\" class=\"absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-2-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://sumanlab.com/wp-content/uploads/2024/05/tipos-de-laboratorio.jpg\" style=\"filter:brightness(.36) saturate(.72) contrast(1.08);\"/>\n            <div aria-hidden=\"true\" class=\"absolute inset-y-0 left-0 w-full bg-[#0f172a] md:w-[43%]\" data-kid=\"1-2-1-2\" data-name=\"hero background overlay\">\n            </div>\n            <div class=\"relative z-10 mx-auto flex w-full max-w-[1180px] flex-col items-start px-6 py-20 md:py-24\" data-kid=\"1-2-1-3\" data-name=\"hero content container\">\n                <div class=\"home-hero-copy mb-5 inline-flex items-center gap-2 border border-[#E52320] bg-[#E52320] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.17em] text-white\" data-kid=\"1-2-1-3-1\" data-name=\"hero category tag\">\n                    <span aria-hidden=\"true\" class=\"hero-indicator h-2 w-2 bg-white\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-1\" data-name=\"hero indicator dot\" data-reason=\"pulsing animation via GSAP\">\n                    </span>\n                    Unidos por tu Salud\n                </div>\n                <div class=\"home-hero-copy mb-7 h-1 w-20 bg-[#E52320]\" data-kid=\"1-2-1-3-2\" data-name=\"hero headline decorative line\">\n                </div>\n                <h1 class=\"home-hero-copy max-w-[720px] font-['Plus_Jakarta_Sans'] text-5xl font-extrabold leading-[.98] tracking-[-0.055em] text-white sm:text-6xl md:text-8xl\" data-kid=\"1-2-1-3-3\" data-name=\"hero headline text\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                    UNIDOSLAB\n                </h1>\n                <p class=\"home-hero-copy mt-7 max-w-[590px] text-base font-medium leading-7 text-white sm:text-lg md:text-xl\" data-kid=\"1-2-1-3-4\" data-name=\"hero description text\">\n                    Resultados precisos, alta tecnología y el mejor respaldo profesional. Unidos por tu Salud.\n                </p>\n                <p class=\"home-hero-copy mt-8 border-l-4 border-[#E52320] pl-4 text-[11px] font-bold uppercase tracking-[0.16em] text-[#dbe4ea]\" data-kid=\"1-2-1-3-5\" data-name=\"hero footer metadata text\">\n                    Laboratorio clínico · Diagnóstico confiable\n                </p>\n            </div>\n        </section>\n        <section class=\"relative z-10 mx-auto w-full max-w-[1180px] bg-white px-6 py-8 md:-mt-24 md:py-0\" data-home-cards-section=\"\" data-kid=\"1-2-2\" data-name=\"features cards section\">\n            <div class=\"grid grid-cols-1 gap-5 md:grid-cols-3 md:gap-6\" data-home-cards=\"\" data-kid=\"1-2-2-1\" data-name=\"features cards grid\">\n                <article aria-label=\"Explorar Exámenes\" class=\"home-card group flex min-h-[286px] cursor-pointer flex-col border border-[#cbd9e3] border-t-4 border-t-[#E52320] bg-white shadow-[8px_8px_0_#1E3A4C] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E52320]\" data-card-index=\"0\" data-kid=\"1-2-2-1-1\" data-name=\"exams card\" role=\"button\" tabindex=\"0\">\n                    <div class=\"relative\" data-kid=\"1-2-2-1-1-1\" data-name=\"card visual header\">\n                        <div class=\"home-card-image h-[112px] w-full overflow-hidden bg-[#e8eef5]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"card image wrapper\">\n                            <img alt=\"Microscopio y equipamiento para exámenes clínicos — Tima Miroshnichenko / Pexels\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"exams image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/9574397/pexels-photo-9574397.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                        </div>\n                        <div class=\"home-card-icon absolute left-5 top-4 flex h-12 w-12 items-center justify-center border border-[#dbe4ea] bg-white text-[#E52320] shadow-[4px_4px_0_#1E3A4C]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"card icon wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-microscope text-2xl\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"microscope icon\">\n                            </i>\n                        </div>\n                        <div class=\"flex h-[52px] items-center justify-between bg-[#1E3A4C] px-5\" data-kid=\"1-2-2-1-1-1-3\" data-name=\"card title bar\">\n                            <div class=\"flex items-center gap-3 pl-[68px]\" data-kid=\"1-2-2-1-1-1-3-3\" data-name=\"card index and title wrapper\">\n                                <span class=\"text-[9px] font-bold uppercase tracking-[0.2em] text-[#a9c1d0]\" data-kid=\"1-2-2-1-1-1-3-3-1\" data-name=\"card index text\">\n                                    01\n                                </span>\n                                <h2 class=\"font-['Plus_Jakarta_Sans'] text-lg font-extrabold tracking-[-0.035em] text-white\" data-kid=\"1-2-2-1-1-1-3-1\" data-name=\"card title\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                                    Exámenes\n                                </h2>\n                            </div>\n                            <div class=\"home-card-arrow flex h-8 w-8 items-center justify-center border border-white bg-white text-[#1E3A4C]\" data-kid=\"1-2-2-1-1-1-3-2\" data-name=\"card arrow wrapper\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-base\" data-kid=\"1-2-2-1-1-1-3-2-1\" data-name=\"arrow icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col bg-white px-5 py-4\" data-kid=\"1-2-2-1-1-2\" data-name=\"card content container\">\n                        <span class=\"home-card-accent mb-2 block h-1 w-10 origin-left bg-[#E52320]\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"card accent line\">\n                        </span>\n                        <p class=\"text-xs font-medium leading-5 text-[#5f7590]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"card description text\">\n                            Catálogo de análisis clínicos y pruebas de laboratorio especializadas.\n                        </p>\n                        <span class=\"mt-auto pt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#E52320]\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"card action text\">\n                            Explorar servicios\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-1 text-xs\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"card action arrow icon\">\n                            </i>\n                        </span>\n                    </div>\n                </article>\n                <article aria-label=\"Consultar resultados\" class=\"home-card group flex min-h-[286px] cursor-pointer flex-col border border-[#cbd9e3] border-t-4 border-t-[#E52320] bg-white shadow-[8px_8px_0_#1E3A4C] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E52320]\" data-card-index=\"1\" data-kid=\"1-2-2-1-2\" data-name=\"results card\" role=\"button\" tabindex=\"0\">\n                    <div class=\"relative\" data-kid=\"1-2-2-1-2-1\" data-name=\"card visual header\">\n                        <div class=\"home-card-image h-[112px] w-full overflow-hidden bg-[#e8eef5]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"card image wrapper\">\n                            <img alt=\"Consulta digital de resultados de laboratorio\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"results image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=800&q=80\"/>\n                        </div>\n                        <div class=\"home-card-icon absolute left-5 top-4 flex h-12 w-12 items-center justify-center border border-[#dbe4ea] bg-white text-[#E52320] shadow-[4px_4px_0_#1E3A4C]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"card icon wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-file-check text-2xl\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"file check icon\">\n                            </i>\n                        </div>\n                        <div class=\"flex h-[52px] items-center justify-between bg-[#1E3A4C] px-5\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"card title bar\">\n                            <div class=\"flex items-center gap-3 pl-[68px]\" data-kid=\"1-2-2-1-2-1-3-3\" data-name=\"card index and title wrapper\">\n                                <span class=\"text-[9px] font-bold uppercase tracking-[0.2em] text-[#a9c1d0]\" data-kid=\"1-2-2-1-2-1-3-3-1\" data-name=\"card index text\">\n                                    02\n                                </span>\n                                <h2 class=\"font-['Plus_Jakarta_Sans'] text-lg font-extrabold tracking-[-0.035em] text-white\" data-kid=\"1-2-2-1-2-1-3-1\" data-name=\"card title\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                                    Ver resultados\n                                </h2>\n                            </div>\n                            <div class=\"home-card-arrow flex h-8 w-8 items-center justify-center border border-white bg-white text-[#1E3A4C]\" data-kid=\"1-2-2-1-2-1-3-2\" data-name=\"card arrow wrapper\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-base\" data-kid=\"1-2-2-1-2-1-3-2-1\" data-name=\"arrow icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col bg-white px-5 py-4\" data-kid=\"1-2-2-1-2-2\" data-name=\"card content container\">\n                        <span class=\"home-card-accent mb-2 block h-1 w-10 origin-left bg-[#E52320]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"card accent line\">\n                        </span>\n                        <p class=\"text-xs font-medium leading-5 text-[#5f7590]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"card description text\">\n                            Acceda a sus resultados de laboratorio en línea de manera segura y rápida.\n                        </p>\n                        <span class=\"mt-auto pt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#E52320]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"card action text\">\n                            Consultar ahora\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-1 text-xs\" data-kid=\"1-2-2-1-2-2-3-1\" data-name=\"card action arrow icon\">\n                            </i>\n                        </span>\n                    </div>\n                </article>\n                <article aria-label=\"Conocer Ecografías\" class=\"home-card group flex min-h-[286px] cursor-pointer flex-col border border-[#cbd9e3] border-t-4 border-t-[#E52320] bg-white shadow-[8px_8px_0_#1E3A4C] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E52320]\" data-card-index=\"2\" data-kid=\"1-2-2-1-3\" data-name=\"ecography card\" role=\"button\" tabindex=\"0\">\n                    <div class=\"relative\" data-kid=\"1-2-2-1-3-1\" data-name=\"card visual header\">\n                        <div class=\"home-card-image h-[112px] w-full overflow-hidden bg-[#e8eef5]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"card image wrapper\">\n                            <img alt=\"Equipo de ecografía para diagnóstico por imágenes\" class=\"h-full w-full object-cover\" data-kid=\"1-2-2-1-3-1-1-1\" data-name=\"ecography image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&w=800&q=80\"/>\n                        </div>\n                        <div class=\"home-card-icon absolute left-5 top-4 flex h-12 w-12 items-center justify-center border border-[#dbe4ea] bg-white text-[#E52320] shadow-[4px_4px_0_#1E3A4C]\" data-kid=\"1-2-2-1-3-1-2\" data-name=\"card icon wrapper\">\n                            <i aria-hidden=\"true\" class=\"ti ti-activity text-2xl\" data-kid=\"1-2-2-1-3-1-2-1\" data-name=\"activity icon\">\n                            </i>\n                        </div>\n                        <div class=\"flex h-[52px] items-center justify-between bg-[#1E3A4C] px-5\" data-kid=\"1-2-2-1-3-1-3\" data-name=\"card title bar\">\n                            <div class=\"flex items-center gap-3 pl-[68px]\" data-kid=\"1-2-2-1-3-1-3-3\" data-name=\"card index and title wrapper\">\n                                <span class=\"text-[9px] font-bold uppercase tracking-[0.2em] text-[#a9c1d0]\" data-kid=\"1-2-2-1-3-1-3-3-1\" data-name=\"card index text\">\n                                    03\n                                </span>\n                                <h2 class=\"font-['Plus_Jakarta_Sans'] text-lg font-extrabold tracking-[-0.035em] text-white\" data-kid=\"1-2-2-1-3-1-3-1\" data-name=\"card title\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                                    Ecografías\n                                </h2>\n                            </div>\n                            <div class=\"home-card-arrow flex h-8 w-8 items-center justify-center border border-white bg-white text-[#1E3A4C]\" data-kid=\"1-2-2-1-3-1-3-2\" data-name=\"card arrow wrapper\">\n                                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-base\" data-kid=\"1-2-2-1-3-1-3-2-1\" data-name=\"arrow icon\">\n                                </i>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-1 flex-col bg-white px-5 py-4\" data-kid=\"1-2-2-1-3-2\" data-name=\"card content container\">\n                        <span class=\"home-card-accent mb-2 block h-1 w-10 origin-left bg-[#E52320]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"card accent line\">\n                        </span>\n                        <p class=\"text-xs font-medium leading-5 text-[#5f7590]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"card description text\">\n                            Servicios de diagnóstico por imágenes y ecografías de alta definición.\n                        </p>\n                        <span class=\"mt-auto pt-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#E52320]\" data-kid=\"1-2-2-1-3-2-3\" data-name=\"card action text\">\n                            Conocer servicio\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right ml-1 text-xs\" data-kid=\"1-2-2-1-3-2-3-1\" data-name=\"card action arrow icon\">\n                            </i>\n                        </span>\n                    </div>\n                </article>\n            </div>\n        </section>\n    </main>\n    <a aria-label=\"Contactar a UNIDOSLAB por WhatsApp\" class=\"fixed bottom-7 right-7 z-40 inline-flex items-center gap-3 border border-[#047857] bg-[#10b981] px-5 py-4 text-sm font-bold uppercase tracking-[0.1em] text-white shadow-[6px_6px_0_#047857]\" data-kid=\"1-3\" data-name=\"whatsapp floating button\" href=\"https://api.whatsapp.com/send/?phone=51952920616&text=Hola%20UNIDOSLAB,%20deseo%20mayor%20informaci%C3%B3n\" rel=\"noopener noreferrer\" target=\"_blank\">\n        <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp text-2xl\" data-kid=\"1-3-1\" data-name=\"whatsapp icon\">\n        </i>\n        <span class=\"hidden sm:inline\" data-kid=\"1-3-2\" data-name=\"whatsapp label text\">\n            WhatsApp\n        </span>\n    </a>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script>\n        (() => {\n      const root = document.querySelector('[data-home-view]');\n      if (!root || typeof gsap === 'undefined') return;\n      const heroCopy = root.querySelectorAll('.home-hero-copy');\n      const cards = root.querySelectorAll('.home-card');\n      const indicator = root.querySelector('.hero-indicator');\n      const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n      const reduceMotion = reduceMotionQuery.matches;\n\n      if (reduceMotion) {\n        gsap.set([...heroCopy, ...cards], { autoAlpha: 1, y: 0 });\n      } else {\n        gsap.timeline({ defaults: { ease: 'power3.out' } })\n          .from(heroCopy, { autoAlpha: 0, y: 24, duration: 0.7, stagger: 0.1 })\n          .from(cards, { autoAlpha: 0, y: 40, duration: 0.65, stagger: 0.12 }, '-=0.22');\n      }\n\n      const indicatorLoop = reduceMotion ? null : gsap.to(indicator, { scale: 1.18, duration: 1.5, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n      const cardTweens = [];\n\n      cards.forEach((card) => {\n        const icon = card.querySelector('.home-card-icon');\n        const arrow = card.querySelector('.home-card-arrow');\n        const image = card.querySelector('.home-card-image');\n        const accent = card.querySelector('.home-card-accent');\n        const enter = () => {\n          if (reduceMotion) return;\n          gsap.to(icon, { y: -4, rotation: 2, duration: 0.32, ease: 'power2.out', overwrite: true });\n          gsap.to(arrow, { x: 4, y: -4, duration: 0.28, ease: 'power2.out', overwrite: true });\n          gsap.to(image, { scale: 1.035, duration: 0.55, ease: 'power2.out', overwrite: true });\n          gsap.to(accent, { scaleX: 1.45, duration: 0.35, ease: 'power2.out', overwrite: true });\n        };\n        const leave = () => {\n          if (reduceMotion) return;\n          gsap.to(icon, { y: 0, rotation: 0, duration: 0.4, ease: 'power2.out', overwrite: true });\n          gsap.to(arrow, { x: 0, y: 0, duration: 0.34, ease: 'power2.out', overwrite: true });\n          gsap.to(image, { scale: 1, duration: 0.55, ease: 'power2.out', overwrite: true });\n          gsap.to(accent, { scaleX: 1, duration: 0.35, ease: 'power2.out', overwrite: true });\n        };\n        card.addEventListener('pointerenter', enter);\n        card.addEventListener('pointerleave', leave);\n        card.addEventListener('focus', enter);\n        card.addEventListener('blur', leave);\n        cardTweens.push({ card, enter, leave });\n      });\n\n      const handleVisibility = () => {\n        if (!indicatorLoop) return;\n        document.hidden ? indicatorLoop.pause() : indicatorLoop.resume();\n      };\n      document.addEventListener('visibilitychange', handleVisibility);\n      window.addEventListener('pagehide', () => {\n        indicatorLoop?.kill();\n        cardTweens.forEach(({ card, enter, leave }) => {\n          card.removeEventListener('pointerenter', enter);\n          card.removeEventListener('pointerleave', leave);\n          card.removeEventListener('focus', enter);\n          card.removeEventListener('blur', leave);\n        });\n        document.removeEventListener('visibilitychange', handleVisibility);\n      }, { once: true });\n    })();\n    </script>\n</div>\n",
