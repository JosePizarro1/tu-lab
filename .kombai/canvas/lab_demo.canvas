      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n</style>\n<div class=\"min-h-screen w-full bg-[var(--page)] font-['IBM_Plex_Sans'] text-slate-700\" data-kid=\"1\" data-name=\"results inquiry page\" style=\"--brand-red:#E52320; --brand-navy:#1E3A4C; --ink:#0f172a; --page:#eef3f7; --surface:#f8fafc; --overlay-strong:rgba(15,37,51,.92); --overlay-mid:rgba(15,37,51,.62); --overlay-soft:rgba(15,37,51,.12); font-family:'IBM Plex Sans', sans-serif;\">\n    <header class=\"sticky top-0 z-30 border-b border-slate-100 bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"mx-auto flex h-[78px] w-full max-w-[1180px] items-center justify-between gap-8 px-6 lg:px-0\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <a aria-label=\"UNIDOSLAB, ir al inicio\" class=\"shrink-0\" data-kid=\"1-1-1-1\" href=\"#resultados\">\n                <img alt=\"UNIDOSLAB - Unidos por tu Salud\" class=\"h-10 w-auto object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo-unidoslab.webp\"/>\n            </a>\n            <div class=\"relative hidden w-full max-w-[510px] md:block\" data-kid=\"1-1-1-2\">\n                <label class=\"sr-only\" data-kid=\"1-1-1-2-1\" for=\"site-search\">\n                    Buscar en UNIDOSLAB\n                </label>\n                <input class=\"h-11 w-full rounded-full border border-slate-100 bg-slate-50/80 pl-12 pr-5 text-sm font-medium text-slate-700 outline-none placeholder:text-slate-400 focus:border-red-200 focus:bg-white focus:ring-4 focus:ring-red-50\" data-kid=\"1-1-1-2-2\" id=\"site-search\" placeholder=\"Busque exámenes, sedes, etc...\" type=\"search\"/>\n                <i aria-hidden=\"true\" class=\"ti ti-search pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-xl text-slate-400\" data-kid=\"1-1-1-2-3\">\n                </i>\n            </div>\n            <div class=\"w-10 shrink-0 md:hidden\" data-kid=\"1-1-1-3\">\n            </div>\n        </div>\n        <nav aria-label=\"Navegación principal\" class=\"border-t border-slate-100 bg-white\" data-kid=\"1-1-2\" data-name=\"main navigation menu\">\n            <ul class=\"mx-auto flex h-[54px] max-w-[620px] items-stretch justify-center gap-1 px-4 sm:gap-4\" data-kid=\"1-1-2-1\" data-name=\"navigation link list\">\n                <li data-kid=\"1-1-2-1-1\">\n                    <a class=\"relative flex h-full items-center px-3 text-xs font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-800\" data-kid=\"1-1-2-1-1-1\" data-name=\"home link\" href=\"#inicio\">\n                        Inicio\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-2\">\n                    <a class=\"relative flex h-full items-center gap-1 px-3 text-xs font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-800\" data-kid=\"1-1-2-1-2-1\" data-name=\"services link\" href=\"#servicios\">\n                        Servicios\n                        <span class=\"text-[10px]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"dropdown icon\">\n                            ▼\n                        </span>\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-3\">\n                    <a class=\"relative flex h-full items-center px-3 text-xs font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-800\" data-kid=\"1-1-2-1-3-1\" data-name=\"for doctors link\" href=\"#medico\">\n                        Soy Médico\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-4\">\n                    <a class=\"relative flex h-full items-center px-3 text-xs font-bold uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-800\" data-kid=\"1-1-2-1-4-1\" data-name=\"branches link\" href=\"#sedes\">\n                        Sedes\n                    </a>\n                </li>\n                <li data-kid=\"1-1-2-1-5\">\n                    <a aria-current=\"page\" class=\"relative flex h-full items-center px-3 text-xs font-bold uppercase tracking-[0.12em] text-[var(--brand-red)] before:absolute before:bottom-0 before:left-2 before:right-2 before:h-[3px] before:rounded-t-full before:bg-[var(--brand-red)]\" data-kid=\"1-1-2-1-5-1\" data-name=\"active results link\" href=\"#resultados\">\n                        Resultados\n                    </a>\n                </li>\n            </ul>\n        </nav>\n    </header>\n    <main class=\"relative overflow-hidden px-5 py-8 sm:px-8 sm:py-12 lg:min-h-[calc(100vh-132px)] lg:py-14\" data-kid=\"1-2\" data-name=\"results main content\" id=\"resultados\">\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\" data-kid=\"1-2-1\" data-name=\"background decorative gradient\" style=\"background:radial-gradient(circle at 80% 8%, rgba(229,35,32,.10), transparent 24rem);\">\n        </div>\n        <div class=\"relative mx-auto grid w-full max-w-[1180px] items-stretch gap-6 lg:min-h-[560px] lg:grid-cols-[1.04fr_.96fr] lg:gap-8\" data-kid=\"1-2-2\" data-name=\"results card layout container\">\n            <section class=\"relative min-h-[360px] overflow-hidden rounded-[30px] bg-[var(--brand-navy)] shadow-[0_24px_60px_-30px_rgba(15,23,42,.45)] lg:min-h-0\" data-kid=\"1-2-2-1\" data-name=\"clinical image panel\">\n                <img alt=\"Técnica de laboratorio trabajando con un microscopio — Pavel Danilyuk / Pexels\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-2-1-1\" data-name=\"lab tech working on microscope image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/8442574/pexels-photo-8442574.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                <div aria-hidden=\"true\" class=\"absolute inset-0\" data-kid=\"1-2-2-1-2\" data-name=\"image gradient overlay\" style=\"background:linear-gradient(110deg, var(--overlay-strong) 0%, var(--overlay-mid) 53%, var(--overlay-soft) 100%);\">\n                </div>\n                <div aria-hidden=\"true\" class=\"absolute inset-0 opacity-20\" data-kid=\"1-2-2-1-3\" data-name=\"grid decorative pattern\" style=\"background-image:linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);background-size:36px 36px;\">\n                </div>\n                <div class=\"relative flex h-full min-h-[360px] flex-col justify-between p-7 text-white sm:p-10 lg:min-h-0\" data-kid=\"1-2-2-1-4\" data-name=\"image panel text container\">\n                    <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-2-2-1-4-1\" data-name=\"panel header row\">\n                        <div class=\"inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-white/90 backdrop-blur-sm\" data-kid=\"1-2-2-1-4-1-1\" data-name=\"status pill\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--brand-red)] shadow-[0_0_0_4px_rgba(229,35,32,.18)]\" data-kid=\"1-2-2-1-4-1-1-1\" data-name=\"status indicator dot\">\n                            </span>\n                            Consulta segura\n                        </div>\n                        <div class=\"flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/10 text-white/90 backdrop-blur-sm\" data-kid=\"1-2-2-1-4-1-2\" data-name=\"icon container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-shield-check text-xl\" data-kid=\"1-2-2-1-4-1-2-1\" data-name=\"shield check icon\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"max-w-[460px]\" data-kid=\"1-2-2-1-4-2\" data-name=\"text content group\">\n                        <p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-white/65\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"portal label text\">\n                            Portal de pacientes\n                        </p>\n                        <h1 class=\"font-['Plus_Jakarta_Sans'] text-3xl font-extrabold leading-[1.08] tracking-[-0.04em] text-white sm:text-4xl\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"results card headline\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                            Tus resultados, claros y disponibles cuando los necesites.\n                        </h1>\n                        <p class=\"mt-5 max-w-[390px] text-sm leading-6 text-white/75\" data-kid=\"1-2-2-1-4-2-3\" data-name=\"results card description\">\n                            Consulta tus análisis clínicos de forma privada con tu documento y código de orden.\n                        </p>\n                        <div class=\"mt-8 flex flex-wrap items-center gap-3 text-[11px] font-semibold text-white/75\" data-kid=\"1-2-2-1-4-2-4\" data-name=\"features row\">\n                            <span class=\"inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/10 px-3 py-2 backdrop-blur-sm\" data-kid=\"1-2-2-1-4-2-4-1\" data-name=\"access badge\">\n                                <i aria-hidden=\"true\" class=\"ti ti-lock text-sm text-emerald-300\" data-kid=\"1-2-2-1-4-2-4-1-1\" data-name=\"lock icon\">\n                                </i>\n                                Acceso protegido\n                            </span>\n                            <span class=\"inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/10 px-3 py-2 backdrop-blur-sm\" data-kid=\"1-2-2-1-4-2-4-2\" data-name=\"device badge\">\n                                <i aria-hidden=\"true\" class=\"ti ti-device-desktop text-sm text-sky-200\" data-kid=\"1-2-2-1-4-2-4-2-1\" data-name=\"desktop icon\">\n                                </i>\n                                Desde cualquier dispositivo\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex items-end justify-between gap-4 border-t border-white/15 pt-5 text-[10px] font-medium uppercase tracking-[0.13em] text-white/55\" data-kid=\"1-2-2-1-4-3\" data-name=\"panel footer row\">\n                        <span data-kid=\"1-2-2-1-4-3-1\" data-name=\"brand name\">\n                            UNIDOSLAB\n                        </span>\n                        <span data-kid=\"1-2-2-1-4-3-2\" data-name=\"tagline\">\n                            Unidos por tu salud\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"results-heading\" class=\"relative flex flex-col justify-center overflow-hidden rounded-[30px] border border-slate-200/80 bg-white p-6 shadow-[0_24px_60px_-34px_rgba(15,23,42,.34)] sm:p-9 lg:p-11\" data-kid=\"1-2-2-2\" data-name=\"results inquiry card\">\n                <div aria-hidden=\"true\" class=\"absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[var(--brand-red)] via-red-400 to-amber-300\" data-kid=\"1-2-2-2-1\" data-name=\"results top decorative gradient bar\">\n                </div>\n                <div class=\"text-center\" data-kid=\"1-2-2-2-2\" data-name=\"card header section\">\n                    <div class=\"mx-auto flex h-[68px] w-[68px] items-center justify-center rounded-full border border-red-100 bg-red-50/60 text-[var(--brand-red)] shadow-[0_8px_20px_-14px_rgba(229,35,32,.5)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"shield icon container\">\n                        <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[34px]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"shield check icon\">\n                        </i>\n                    </div>\n                    <p class=\"mt-6 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--brand-red)]\" data-kid=\"1-2-2-2-2-2\" data-name=\"inquiry label text\">\n                        Consulta de resultados\n                    </p>\n                    <h2 class=\"mt-2 font-['Plus_Jakarta_Sans'] text-[28px] font-extrabold leading-tight tracking-[-0.04em] text-slate-950 sm:text-[32px]\" data-kid=\"1-2-2-2-2-3\" data-name=\"results page title\" id=\"results-heading\" style=\"font-family:'Plus Jakarta Sans', sans-serif;\">\n                        Consulte sus Resultados\n                    </h2>\n                    <p class=\"mx-auto mt-3 max-w-[390px] text-[15px] leading-6 text-slate-500\" data-kid=\"1-2-2-2-2-4\" data-name=\"results page description\">\n                        Ingrese los datos indicados en su orden de atención.\n                    </p>\n                </div>\n                <form aria-label=\"Consulta de resultados de laboratorio\" class=\"mt-9 space-y-5\" data-kid=\"1-2-2-2-3\" data-name=\"results search form\">\n                    <div data-kid=\"1-2-2-2-3-1\" data-name=\"document number field group\">\n                        <label class=\"mb-2.5 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"document number label\" for=\"document-number\">\n                            Número de Documento\n                        </label>\n                        <input class=\"h-[60px] w-full rounded-[15px] border border-slate-200 bg-slate-50/75 px-5 text-[16px] font-medium text-slate-800 outline-none placeholder:text-slate-400 focus:border-red-300 focus:bg-white focus:ring-4 focus:ring-red-50\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"document number input\" id=\"document-number\" name=\"document-number\" placeholder=\"DNI / C.E.\" type=\"text\"/>\n                    </div>\n                    <div data-kid=\"1-2-2-2-3-2\" data-name=\"order code field group\">\n                        <label class=\"mb-2.5 block text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"order code label\" for=\"order-code\">\n                            Código de Orden\n                        </label>\n                        <input aria-describedby=\"order-code-hint\" class=\"h-[60px] w-full rounded-[15px] border-[1.5px] border-[var(--brand-red)] bg-white px-5 text-[16px] font-medium text-slate-800 outline-none ring-4 ring-red-50/80 placeholder:text-slate-400\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"order code input field\" id=\"order-code\" name=\"order-code\" placeholder=\"Ej: ORD-998877\" type=\"text\"/>\n                        <span class=\"sr-only\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"order code accessibility hint\" id=\"order-code-hint\">\n                            Campo listo para ingresar el código de orden\n                        </span>\n                    </div>\n                    <button class=\"flex h-[60px] w-full items-center justify-center gap-2 rounded-[15px] bg-[var(--brand-red)] px-6 text-[12px] font-bold uppercase tracking-[0.08em] text-white shadow-[0_10px_24px_-14px_rgba(15,23,42,.8)] transition-all hover:-translate-y-0.5 hover:bg-red-700 focus:outline-none focus:ring-4 focus:ring-red-100\" data-kid=\"1-2-2-2-3-3\" data-name=\"search results button\" type=\"button\">\n                        Buscar Resultados\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-lg\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"arrow right icon\">\n                        </i>\n                    </button>\n                </form>\n                <div class=\"mt-6 flex items-center justify-center gap-2 text-[11px] font-medium text-slate-400\" data-kid=\"1-2-2-2-4\" data-name=\"privacy disclaimer container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-lock text-sm text-emerald-500\" data-kid=\"1-2-2-2-4-1\" data-name=\"privacy lock icon\">\n                    </i>\n                    Tus datos se consultan de forma privada\n                </div>\n            </section>\n        </div>\n    </main>\n    <a aria-label=\"Contactar a UNIDOSLAB por WhatsApp\" class=\"fixed bottom-6 right-5 z-40 inline-flex items-center gap-2.5 rounded-full bg-emerald-500 px-5 py-3.5 text-sm font-bold uppercase tracking-[0.1em] text-white shadow-[0_12px_24px_-10px_rgba(16,185,129,.75)] transition-all hover:-translate-y-0.5 hover:bg-emerald-600 focus:outline-none focus:ring-4 focus:ring-emerald-100 sm:right-7\" data-kid=\"1-3\" data-name=\"whatsapp floating action button\" href=\"https://api.whatsapp.com/send/?phone=51952920616&text=Hola%20UNIDOSLAB,%20deseo%20mayor%20informaci%C3%B3n\" rel=\"noopener noreferrer\" target=\"_blank\">\n        <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp text-[25px]\" data-kid=\"1-3-1\" data-name=\"whatsapp icon\">\n        </i>\n        <span class=\"hidden sm:inline\" data-kid=\"1-3-2\" data-name=\"whatsapp button text\">\n            WhatsApp\n        </span>\n    </a>\n</div>\n",
